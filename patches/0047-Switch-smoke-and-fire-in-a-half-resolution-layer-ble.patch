+			blend.dstAlphaBlendFactor = VK_BLEND_FACTOR_ONE;
+		else if (blend.dstColorBlendFactor == VK_BLEND_FACTOR_ONE || blend.dstColorBlendFactor == VK_BLEND_FACTOR_ZERO)
