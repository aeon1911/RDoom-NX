From 56215b8237c1127b29d027a705eddad909166282 Mon Sep 17 00:00:00 2001
From: RDoom <171243930+aeon1911@users.noreply.github.com>
Date: Sun, 11 Oct 2026 17:26:52 -0300
Subject: [PATCH 21/55] Switch Vulkan: survive a lost GPU, diagnostics file,
 newest-pipeline evidence

- ZVulkan records VK_ERROR_DEVICE_LOST (VulkanDeviceWasLost + callback). After it
  the pipeline cache is not written, logs/gpu-lost.txt keeps the session report,
  and the next start-up deletes UZDoom's pipeline cache and Mesa's sdmc:/.mesa
  shader cache before Vulkan starts.
- switch/rdoom/rdoom_debug.txt: UPPER-CASE lines are driver environment variables
  (NVK_DEBUG=push_sync, ...), lower-case lines are engine CVARs
  (rd_vk_frameoverlap=0, ...); applied ones are listed in the session report.
- Session report: vertex-format support and the newest pipeline created
  (vulkan_last_new_pipeline), so a fault right after a new effect is traceable.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../ZVulkan/include/zvulkan/vulkaninstance.h  | 11 ++++++
 libraries/ZVulkan/src/vulkaninstance.cpp      |  3 ++
 src/common/platform/posix/nx/rdoom_nx.cpp     | 39 +++++++++++++++++++
 src/common/platform/posix/nx/rdoom_nx.h       |  6 +++
 src/common/platform/posix/sdl/sdlglvideo.cpp  | 37 ++++++++++++++++++
 .../vulkan/renderer/vk_renderpass.cpp         | 21 ++++++++++
 .../vulkan/system/vk_renderdevice.cpp         | 22 ++++++++++-
 7 files changed, 138 insertions(+), 1 deletion(-)

diff --git a/libraries/ZVulkan/include/zvulkan/vulkaninstance.h b/libraries/ZVulkan/include/zvulkan/vulkaninstance.h
index 1074ce420..9eefd05a2 100644
--- a/libraries/ZVulkan/include/zvulkan/vulkaninstance.h
+++ b/libraries/ZVulkan/include/zvulkan/vulkaninstance.h
@@ -96,8 +96,19 @@ std::string VkResultToString(VkResult result);
 void VulkanPrintLog(const char* typestr, const std::string& msg);
 void VulkanError(const char* text);
 
+// Set the first time any call reports VK_ERROR_DEVICE_LOST; the callback lets
+// the platform layer record it (e.g. so a cache written afterwards is skipped).
+extern bool VulkanDeviceWasLost;
+extern void (*VulkanDeviceLostCallback)(const char *what);
+
 inline void CheckVulkanError(VkResult result, const char* text)
 {
 	if (result >= VK_SUCCESS) return;
+	if (result == VK_ERROR_DEVICE_LOST && !VulkanDeviceWasLost)
+	{
+		VulkanDeviceWasLost = true;
+		if (VulkanDeviceLostCallback)
+			VulkanDeviceLostCallback(text);
+	}
 	VulkanError((text + std::string(": ") + VkResultToString(result)).c_str());
 }
diff --git a/libraries/ZVulkan/src/vulkaninstance.cpp b/libraries/ZVulkan/src/vulkaninstance.cpp
index 0641d3987..32b9afdf6 100644
--- a/libraries/ZVulkan/src/vulkaninstance.cpp
+++ b/libraries/ZVulkan/src/vulkaninstance.cpp
@@ -6,6 +6,9 @@
 #include <string>
 #include <cstring>
 
+bool VulkanDeviceWasLost = false;
+void (*VulkanDeviceLostCallback)(const char *what) = nullptr;
+
 VulkanInstance::VulkanInstance(std::vector<uint32_t> apiVersionsToTry, std::set<std::string> requiredExtensions, std::set<std::string> optionalExtensions, bool wantDebugLayer)
 	: ApiVersionsToTry(std::move(apiVersionsToTry)), RequiredExtensions(std::move(requiredExtensions)), OptionalExtensions(std::move(optionalExtensions)), WantDebugLayer(wantDebugLayer)
 {
diff --git a/src/common/platform/posix/nx/rdoom_nx.cpp b/src/common/platform/posix/nx/rdoom_nx.cpp
index abb6f043a..205c0034c 100644
--- a/src/common/platform/posix/nx/rdoom_nx.cpp
+++ b/src/common/platform/posix/nx/rdoom_nx.cpp
@@ -194,6 +194,28 @@ void RDoom_NXEarlyInit()
 	unlink(RDOOM_SD_ROOT "/logs/engine-session.txt");
 	RLOG_I("boot", "%s (%s, %s), engine %s", RDOOM_VERSION_STRING, RDOOM_BUILD_DATE, RDOOM_GIT_DESCRIBE, RDOOM_ENGINE_VERSION);
 	RLOG_I("boot", "clock policy: stock (RDoom never changes CPU/GPU/memory clocks)");
+
+	// The previous session lost the GPU: start the shader caches from scratch,
+	// so a pipeline or shader binary written around the failure is never reused.
+	if (FileExists(RDOOM_SD_ROOT "/logs/gpu-lost.txt"))
+	{
+		RLOG_W("boot", "previous session lost the GPU: clearing shader caches (%d files)", RDoom_ClearShaderCaches());
+		RemoveFile(RDOOM_SD_ROOT "/logs/gpu-lost-previous.txt");
+		rename(RDOOM_SD_ROOT "/logs/gpu-lost.txt", RDOOM_SD_ROOT "/logs/gpu-lost-previous.txt");
+	}
+}
+
+int RDoom_ClearShaderCaches()
+{
+	int n = 0;
+	// UZDoom's Vulkan pipeline cache (written on exit)
+	if (RemoveFile(RDOOM_SD_ROOT "/cache/uzdoom/vulkanpipelinecache"))
+		n++;
+	// Mesa's on-disk shader cache (NVK and the GL driver)
+	const int m = RemoveTree("sdmc:/.mesa/mesa_shader_cache_sf");
+	if (m > 0)
+		n += m;
+	return n;
 }
 
 bool RDoom_NXLauncherUsedDisplay()
@@ -291,6 +313,23 @@ write:
 	RLOG_I("session", "%s: %s", key, value);
 }
 
+// Called by ZVulkan the first time the GPU is reported lost: leaves a marker
+// with everything the session report knows (newest pipeline, frames presented),
+// read by the next start-up.
+void RDoom_VulkanDeviceLost(const char *what)
+{
+	RDoom_SessionSet("vulkan_device_lost", what ? what : "?");
+	std::string out = std::string("GPU lost: ") + (what ? what : "?") + "\n";
+	for (auto &kv : g_session)
+		out += kv.first + ": " + kv.second + "\n";
+	FILE *f = fopen(RDOOM_SD_ROOT "/logs/gpu-lost.txt", "w");
+	if (f)
+	{
+		fwrite(out.data(), 1, out.size(), f);
+		fclose(f);
+	}
+}
+
 void RDoom_SessionLog(const char *category, const char *message)
 {
 	RLOG_I(category, "%s", message);
diff --git a/src/common/platform/posix/nx/rdoom_nx.h b/src/common/platform/posix/nx/rdoom_nx.h
index 50beb4a01..1a7e2be1f 100644
--- a/src/common/platform/posix/nx/rdoom_nx.h
+++ b/src/common/platform/posix/nx/rdoom_nx.h
@@ -18,3 +18,9 @@ void RDoom_SessionSet(const char *key, const char *value);
 void RDoom_SessionLog(const char *category, const char *message);
 // Appends one line to logs/boot.log with an unbuffered write (start-up steps).
 void RDoom_Crumb(const char *what);
+
+// Deletes UZDoom's Vulkan pipeline cache and Mesa's shader cache. Returns files removed.
+int RDoom_ClearShaderCaches();
+// Marker logs/gpu-lost.txt (+ session line) after VK_ERROR_DEVICE_LOST; the next
+// start-up clears the shader caches when it finds it.
+void RDoom_VulkanDeviceLost(const char *what);
diff --git a/src/common/platform/posix/sdl/sdlglvideo.cpp b/src/common/platform/posix/sdl/sdlglvideo.cpp
index 39cce649a..eec7168f2 100644
--- a/src/common/platform/posix/sdl/sdlglvideo.cpp
+++ b/src/common/platform/posix/sdl/sdlglvideo.cpp
@@ -42,6 +42,7 @@
 #include <zvulkan/vulkanbuilders.h>
 #include <zvulkan/vulkandevice.h>
 #include <zvulkan/vulkaninstance.h>
+#include <ctype.h>
 #include <zvulkan/vulkansurface.h>
 #endif
 
@@ -459,6 +460,42 @@ DFrameBuffer *SDLVideo::CreateFrameBuffer ()
 #ifdef __SWITCH__
 	RDoom_SessionSet("renderer_requested", vid_preferbackend == BACKEND_VULKAN ? "vulkan" : vid_preferbackend == BACKEND_OPENGL ? "opengl" : "gles");
 	RDoom_SessionSet("nv_compat", NX_NvCompatStatus());
+	// Diagnostics without a new build: switch/rdoom/rdoom_debug.txt with one
+	// NAME=value per line. UPPER-CASE names are driver environment variables
+	// (NVK_DEBUG=push_sync, NVK_SWITCH_NO_UBO_CBUF=1, ...), applied before the
+	// driver starts; lower-case names are engine CVARs (rd_vk_frameoverlap=0,
+	// r_dynlights=0, ...). Nothing changes when the file is absent.
+	if (FILE *ef = fopen("rdoom_debug.txt", "r"))
+	{
+		char line[256];
+		FString applied;
+		while (fgets(line, sizeof(line), ef))
+		{
+			char *nl = strpbrk(line, "\r\n");
+			if (nl) *nl = 0;
+			char *eq = strchr(line, '=');
+			if (!eq || eq == line || line[0] == '#') continue;
+			*eq = 0;
+			const char *value = eq + 1;
+			if (isupper((unsigned char)line[0]))
+			{
+				setenv(line, value, 1);
+				applied.AppendFormat("%s%s=%s", applied.IsEmpty() ? "" : " ", line, value);
+			}
+			else if (FBaseCVar *cv = FindCVar(line, nullptr))
+			{
+				UCVarValue v;
+				v.String = value;
+				cv->SetGenericRep(v, CVAR_String);
+				applied.AppendFormat("%s%s=%s", applied.IsEmpty() ? "" : " ", line, value);
+			}
+			else
+				applied.AppendFormat("%s%s=?(unknown cvar)", applied.IsEmpty() ? "" : " ", line);
+		}
+		fclose(ef);
+		RDoom_SessionSet("debug_file", applied.GetChars());
+	}
+	VulkanDeviceLostCallback = RDoom_VulkanDeviceLost;
 #endif
 	if (Priv::vulkanEnabled)
 	{
diff --git a/src/common/rendering/vulkan/renderer/vk_renderpass.cpp b/src/common/rendering/vulkan/renderer/vk_renderpass.cpp
index 84a4893c6..4fd851374 100644
--- a/src/common/rendering/vulkan/renderer/vk_renderpass.cpp
+++ b/src/common/rendering/vulkan/renderer/vk_renderpass.cpp
@@ -21,6 +21,9 @@
 */
 
 #include "vk_renderpass.h"
+#ifdef __SWITCH__
+#include "common/platform/posix/nx/rdoom_nx.h"
+#endif
 #include "vk_renderstate.h"
 #include "vk_descriptorset.h"
 #include "vk_raytrace.h"
@@ -68,6 +71,10 @@ VkRenderPassManager::VkRenderPassManager(VulkanRenderDevice* fb) : fb(fb)
 
 VkRenderPassManager::~VkRenderPassManager()
 {
+	// after a lost device the driver may hand back incomplete data; a bad cache
+	// would then break every following session
+	if (VulkanDeviceWasLost)
+		return;
 	try
 	{
 		auto data = PipelineCache->GetCacheData();
@@ -334,6 +341,20 @@ std::unique_ptr<VulkanPipeline> VkRenderPassSetup::CreatePipeline(const VkPipeli
 	builder.RenderPass(GetRenderPass(0));
 	builder.DebugName("VkRenderPassSetup.Pipeline");
 
+#ifdef __SWITCH__
+	// Evidence for GPU faults on hardware: the session report always names the
+	// newest pipeline (a fault right after a new effect/model shows up here).
+	{
+		static unsigned created;
+		FString d, attrs;
+		for (auto &a : vfmt.Attrs)
+			attrs.AppendFormat(" L%d:b%d:f%d", a.location, a.binding, a.format);
+		d.Format("#%u: vertexformat %d (%d bindings, stride %d,%s), effect %d, special %d, alphatest %d, draw %d, layers %d, samples %d, buffers %d",
+			++created, key.VertexFormat, vfmt.NumBindingPoints, (int)vfmt.Stride, attrs.GetChars(), key.EffectState, key.SpecialEffect,
+			key.AlphaTest, key.DrawType, key.NumTextureLayers, PassKey.Samples, PassKey.DrawBuffers);
+		RDoom_SessionSet("vulkan_last_new_pipeline", d.GetChars());
+	}
+#endif
 	return builder.Create(fb->device.get());
 }
 
diff --git a/src/common/rendering/vulkan/system/vk_renderdevice.cpp b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
index c8ede3465..d4c0da21b 100644
--- a/src/common/rendering/vulkan/system/vk_renderdevice.cpp
+++ b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
@@ -126,7 +126,13 @@ VulkanRenderDevice::VulkanRenderDevice(void *hMonitor, bool fullscreen, std::sha
 
 VulkanRenderDevice::~VulkanRenderDevice()
 {
-	vkDeviceWaitIdle(device->device); // make sure the GPU is no longer using any objects before RAII tears them down
+	// make sure the GPU is no longer using any objects before RAII tears them down
+	if (vkDeviceWaitIdle(device->device) == VK_ERROR_DEVICE_LOST && !VulkanDeviceWasLost)
+	{
+		VulkanDeviceWasLost = true;  // no exception here: this is a destructor
+		if (VulkanDeviceLostCallback)
+			VulkanDeviceLostCallback("vkDeviceWaitIdle at shutdown");
+	}
 
 	delete mVertexData;
 	delete mSkyData;
@@ -545,6 +551,20 @@ void VulkanRenderDevice::PrintStartupLog()
 		mt += " (L=device local, V=host visible, Co=coherent, Ca=cached)";
 		RDoom_SessionSet("vulkan_memory_types", mt.GetChars());
 		RDoom_SessionSet("vulkan_frame_overlap", rd_vk_frameoverlap ? "on" : "off");
+
+		// vertex formats the renderer uses (models: packed normals, bone ids)
+		static const struct { VkFormat f; const char *n; } vf[] = {
+			{ VK_FORMAT_R32G32B32A32_SFLOAT, "RGBA32F" }, { VK_FORMAT_R32G32B32_SFLOAT, "RGB32F" },
+			{ VK_FORMAT_R32G32_SFLOAT, "RG32F" }, { VK_FORMAT_R32_SFLOAT, "R32F" }, { VK_FORMAT_R8G8B8A8_UNORM, "RGBA8" },
+			{ VK_FORMAT_A2B10G10R10_SNORM_PACK32, "A2B10G10R10_SNORM" }, { VK_FORMAT_R8G8B8A8_UINT, "RGBA8UI" } };
+		FString fs;
+		for (auto &v : vf)
+		{
+			VkFormatProperties fp = {};
+			vkGetPhysicalDeviceFormatProperties(device->PhysicalDevice.Device, v.f, &fp);
+			fs.AppendFormat("%s%s=%s", fs.IsEmpty() ? "" : ", ", v.n, (fp.bufferFeatures & VK_FORMAT_FEATURE_VERTEX_BUFFER_BIT) ? "ok" : "NO");
+		}
+		RDoom_SessionSet("vulkan_vertex_formats", fs.GetChars());
 	}
 #endif
 	Printf("Vulkan device type: %s\n", deviceType.GetChars());
-- 
