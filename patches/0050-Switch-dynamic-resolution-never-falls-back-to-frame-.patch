From 74c08b37aa94bac306c6c0653d6af5f0b93b3e57 Mon Sep 17 00:00:00 2001
From: RDoom <171243930+aeon1911@users.noreply.github.com>
Date: Tue, 13 Oct 2026 19:40:17 -0300
Subject: [PATCH 50/63] Switch: dynamic resolution never falls back to
 frame-time rules on the console

Console test of 453febfd0 (Lexicon slaughter map with Brutal, 1000-1265
monsters, CPU-bound 20 ms frames, GPU 8.5 ms): the view still stayed at 60%.
After each change the GPU average restarts for 20 frames and the old
frame-time rules ran meanwhile, dropping every rise straight back on the
CPU-bound frames. Once timestamps have been seen the scale now holds while
the average settles; the average restarts with each map (the Lexicon hub's
18 ms no longer carries over). perf.log shows the highest scale per window.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/engine/nx_perf.cpp                          | 7 ++++---
 src/common/rendering/vulkan/system/vk_renderdevice.cpp | 8 ++++++++
 src/common/rendering/vulkan/system/vk_renderdevice.h   | 1 +
 3 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/src/common/engine/nx_perf.cpp b/src/common/engine/nx_perf.cpp
index 181cbc1d0..fe982f1d7 100644
--- a/src/common/engine/nx_perf.cpp
+++ b/src/common/engine/nx_perf.cpp
@@ -53,7 +53,7 @@ static struct
 {
 	double tic, think, display, swap, sndupd, sndstart, tex, scene, bsp, hud, update, gpuwait, frame, gc, wait, net, input, music, client, glsync, glfinish, draw2d, frameend, present, vksubmit, vkclean, vkacquire, vkpresent, vkpending, gpuframe, gpuscene, gpupost, gpuend;
 	int gpuframes;
-	double scalesum; float scalemin;
+	double scalesum; float scalemin, scalemax;
 	double halfarea, halfareamax;
 	int tics, thinkers, sndstarts, drawitems, transitems, glsyncs, spriteskips, draws, lightuploads, lightskips, dynlights, dynlightsall, govlevel, vksubmits, effectsculled, halfeffects;
 } win;
@@ -215,6 +215,7 @@ void NXPerf_EndFrame()
 		win.gpuend += nxperf.gpu_end_ms;
 		win.scalesum += nxperf.scene_scale;
 		if (win.scalemin <= 0 || nxperf.scene_scale < win.scalemin) win.scalemin = nxperf.scene_scale;
+		if (nxperf.scene_scale > win.scalemax) win.scalemax = nxperf.scene_scale;
 		win.draws += nxperf.draws;
 		win.lightuploads += nxperf.lightuploads;
 		win.lightskips += nxperf.lightskips;
@@ -293,9 +294,9 @@ void NXPerf_EndFrame()
 			if (win.gpuframes > 0)
 			{
 				double g = win.gpuframes;
-				fprintf(perfFile, "#   gpu (%s): frame %.2f ms = 3D scene %.2f + post-processing %.2f + 2D/present %.2f (avg of %d frames) | 3D resolution avg %.0f%%, min %.0f%%\n",
+				fprintf(perfFile, "#   gpu (%s): frame %.2f ms = 3D scene %.2f + post-processing %.2f + 2D/present %.2f (avg of %d frames) | 3D resolution avg %.0f%%, min %.0f%%, max %.0f%%\n",
 					NXOperationMode(), win.gpuframe / g, win.gpuscene / g, win.gpupost / g, win.gpuend / g, win.gpuframes,
-					frames ? 100.0 * win.scalesum / frames : 100.0, win.scalemin > 0 ? 100.0 * win.scalemin : 100.0);
+					frames ? 100.0 * win.scalesum / frames : 100.0, win.scalemin > 0 ? 100.0 * win.scalemin : 100.0, win.scalemax > 0 ? 100.0 * win.scalemax : 100.0);
 			}
 			NXGLThreadStats(perfFile);
 			if (NXPerf_SummaryHook) NXPerf_SummaryHook(perfFile);
diff --git a/src/common/rendering/vulkan/system/vk_renderdevice.cpp b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
index 62abe268e..e7054402c 100644
--- a/src/common/rendering/vulkan/system/vk_renderdevice.cpp
+++ b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
@@ -330,6 +330,7 @@ void VulkanRenderDevice::UpdateDynamicResolution()
 	{
 		mDynScale = 1.0f;
 		mDynCalmFrames = 0;
+		mDynGpuSamples = 0;	// a new map starts its own average (the Lexicon hub's must not carry over)
 		return;
 	}
 	// Drop: the previous frame missed vsync and this one had to wait for the
@@ -365,7 +366,14 @@ void VulkanRenderDevice::UpdateDynamicResolution()
 		mDynGpuFrame += (gpuFrame - mDynGpuFrame) * 0.1;
 		mDynGpuScene += (gpuScene - mDynGpuScene) * 0.1;
 		mDynGpuSamples = min(mDynGpuSamples + 1, 1000);
+		mDynGpuSeen = true;
 	}
+	// Once the console has delivered timestamps the frame-time rules are never
+	// used again: they ran while the average settled after each change (20
+	// frames) and, with the CPU over budget (slaughter map, 1000+ monsters,
+	// 20 ms frames), dropped every rise right back to 60% (2026-10-13 test).
+	if (mDynGpuSeen && mDynGpuSamples < 30)
+		return;
 	if (mDynGpuSamples >= 30)
 	{
 		// the 3D view grows with its pixel count; the rest of the frame does not
diff --git a/src/common/rendering/vulkan/system/vk_renderdevice.h b/src/common/rendering/vulkan/system/vk_renderdevice.h
index a34ec3d31..18f9a2369 100644
--- a/src/common/rendering/vulkan/system/vk_renderdevice.h
+++ b/src/common/rendering/vulkan/system/vk_renderdevice.h
@@ -145,6 +145,7 @@ private:
 	double mDynRestAtFull = 3.5;	// GPU ms outside the 3D view at full scale (running average)
 	double mDynGpuFrame = 0, mDynGpuScene = 0;	// GPU ms per frame / for the 3D view (running average)
 	int mDynGpuSamples = 0;
+	bool mDynGpuSeen = false;	// timestamps work here (not in Ryujinx)
 	bool mSceneScaled = false;
 	IntRect mSceneFull, mSceneSmall;
 	void UpdateDynamicResolution();
-- 
