+	const size_t total = n * size;
+	if (size && total / size != n)
+		return nullptr;
+	if (total > kMallocMax)
+		return __real_calloc(n, size);
+	void *p = __wrap_malloc(total);
+	if (p)
+		memset(p, 0, total);
