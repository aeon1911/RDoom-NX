-void NXObj_MarkGameThread() { nxGameHandle = threadGetCurHandle(); }
-#define nxGameThread (nxGameHandle != INVALID_HANDLE && threadGetCurHandle() == nxGameHandle)
+static void *Realloc(void *p, size_t size)
+{
+	if (!p)
+		return Malloc(size);
+	const size_t old = PoolSize(p);
+	if (!old)
+		return __real_realloc(p, size);	// newlib's block stays newlib's
+	if (size == 0)
+	{
+		PoolFree(p);
+		return nullptr;
+	}
+	if (size <= old && size > old / 2)
+		return p;
+	void *q = Malloc(size);
+	if (q)
+	{
+		memcpy(q, p, size < old ? size : old);
+		PoolFree(p);
+	}
+	return q;
+}
 
 extern "C" void *__wrap_malloc(size_t size)
 {
-	if (!nxGameThread) return __real_malloc(size);
