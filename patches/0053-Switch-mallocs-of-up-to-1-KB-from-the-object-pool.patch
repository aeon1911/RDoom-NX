 	const double t = NXPerf_NowMS();
-	void *p = __real_malloc(size);
+	void *p = Malloc(size);
 	nxperf.heap_malloc_ms += NXPerf_NowMS() - t;
 	nxperf.heap_mallocs++;
 	return p;
