From 387dc82794d3decaec0e5d6f3e56545d8a120f57 Mon Sep 17 00:00:00 2001
From: RDoom <171243930+aeon1911@users.noreply.github.com>
Date: Wed, 14 Oct 2026 14:50:40 -0300
Subject: [PATCH 58/65] Switch: dynamic resolution counts the acquire wait;
 hitches weigh one frame

Console test of 6926966ab: Freedoom 2 MAP01 now 58-60 fps (was 54-57),
scale 74-78%. The Lexicon slaughter pack still had a 52 fps stretch with
4.9 ms of wait at frame start, under the 6 ms limit. The sustained wait now
also counts the last frame's acquire and the limit is 4 ms (CPU-bound maps
wait ~1 ms in all). A frame enters the average as at most two vsyncs, so a
loading hitch does not read as 20 slow frames.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/engine/nx_perf.cpp                         |  7 +++++++
 src/common/engine/nx_perf.h                           |  1 +
 .../rendering/vulkan/system/vk_renderdevice.cpp       | 11 ++++++++---
 3 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/src/common/engine/nx_perf.cpp b/src/common/engine/nx_perf.cpp
index 5936ba6be..16f78a778 100644
--- a/src/common/engine/nx_perf.cpp
+++ b/src/common/engine/nx_perf.cpp
@@ -42,6 +42,7 @@ static int linesWritten = 0;
 static FILE *perfFile = nullptr;
 static double sumFrame = 0, maxFrame = 0;
 static double lastTicWaitMS = 0;
+static double lastAcquireMS = 0;
 static int frames = 0;
 static int missed1 = 0, missed2 = 0;	// frames over one / over two vsync intervals
 static double lastSummary = 0;
@@ -117,6 +118,11 @@ double NXPerf_LastTicWaitMS()
 	return lastTicWaitMS;
 }
 
+double NXPerf_LastAcquireMS()
+{
+	return lastAcquireMS;
+}
+
 double NXPerf_LastSimMS()
 {
 	return lastSimMS;
@@ -153,6 +159,7 @@ void NXPerf_EndFrame()
 	lastFrame = now;
 	lastFrameMS = frame;
 	lastTicWaitMS = nxperf.wait_ms;
+	lastAcquireMS = nxperf.vkacquire_ms;
 	lastSimMS = nxperf.tic_ms;
 	lastTicMS = (nxperf.tics > 0) ? nxperf.tic_ms / nxperf.tics : 0;
 
diff --git a/src/common/engine/nx_perf.h b/src/common/engine/nx_perf.h
index 01a96b146..4ee957d4f 100644
--- a/src/common/engine/nx_perf.h
+++ b/src/common/engine/nx_perf.h
@@ -79,6 +79,7 @@ void NXPerf_Note(const char *fmt, ...);
 double NXPerf_LastFrameMS();
 double NXPerf_LastSimMS();
 double NXPerf_LastTicWaitMS();	// the last frame's wait for the next game tic
+double NXPerf_LastAcquireMS();	// the last frame's wait for a swapchain image
 double NXPerf_LastTicMS();
 // set by the game code: writes a breakdown (e.g. which actor classes cost the most) into the summary
 extern void (*NXPerf_SummaryHook)(FILE *f);
diff --git a/src/common/rendering/vulkan/system/vk_renderdevice.cpp b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
index 0c127ba77..7cf588962 100644
--- a/src/common/rendering/vulkan/system/vk_renderdevice.cpp
+++ b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
@@ -382,8 +382,13 @@ void VulkanRenderDevice::UpdateDynamicResolution()
 	// minutes, CPU waiting 13-14 ms for the GPU, timestamps 11 ms: between the
 	// old drop (18.7 ms) and rise (17.5 ms) averages nothing moved the scale.
 	// Now under ~57.7 fps with long waits drops it; a rise needs ~58.8 fps.
-	mDynAvgFrame += (frameMs - mDynAvgFrame) * 0.05;
-	mDynAvgWait += (waitMs - mDynAvgWait) * 0.05;
+	// The sustained wait also counts the last frame's acquire (no swapchain
+	// image free yet: the GPU is behind too): the Lexicon slaughter pack ran
+	// at 52 fps with 4.9 ms at frame start and the old 6 ms limit (console,
+	// engine 6926966ab); CPU-bound maps wait ~1 ms in all.
+	// one loading hitch (0.5 s for a new texture) must not look like 20 slow frames
+	mDynAvgFrame += (min(frameMs, budget * 2.0) - mDynAvgFrame) * 0.05;
+	mDynAvgWait += (waitMs + NXPerf_LastAcquireMS() - mDynAvgWait) * 0.05;
 	if (mDynGpuSeen && mDynGpuSamples < 8)
 		return;
 	if (mDynGpuSamples >= 8)
@@ -391,7 +396,7 @@ void VulkanRenderDevice::UpdateDynamicResolution()
 		// the 3D view grows with its pixel count; the rest of the frame does not
 		auto predict = [&](float scale) { return mDynGpuFrame + mDynGpuScene * ((scale * scale) / (mDynScale * mDynScale) - 1.0); };
 		const bool gpuBound = (frameMs > budget + 1.5 && waitMs > 2.5 && mDynGpuFrame > budget * 0.9) ||
-			(mDynAvgFrame > budget * 1.04 && mDynAvgWait > 6.0);
+			(mDynAvgFrame > budget * 1.04 && mDynAvgWait > 4.0);
 		if (gpuBound && mDynScale > minScale + 0.001f)
 		{
 			if (mDynFramesSinceRise < 120)
