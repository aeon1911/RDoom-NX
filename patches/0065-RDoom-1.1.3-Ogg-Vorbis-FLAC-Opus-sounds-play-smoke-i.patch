From 2e72b192ebb1a2ecf2c81e5521efdd7281c2b6b9 Mon Sep 17 00:00:00 2001
From: RDoom <171243930+aeon1911@users.noreply.github.com>
Date: Fri, 16 Oct 2026 09:09:58 -0300
Subject: [PATCH 65/65] RDoom 1.1.3: Ogg Vorbis/FLAC/Opus sounds play; smoke in
 the camera's face is not drawn

Console (Project Brutality, TNT, 26 minutes): no gunfire, monster or impact
sounds. libsndfile had been built without the Xiph codecs (see the root
repository's docker/Dockerfile), so every Ogg sound failed to decode and was
marked empty; PB's 1433 sounds are Ogg Vorbis. The engine now links vorbisenc,
vorbis, FLAC, opus and ogg. perf.log counts sound requests and why they did or
did not play (started at once, after loading, dropped, refused by reason).

Point-blank gun smoke put a dozen translucent sprites over the whole screen.
Pure effects (never monsters, pickups, hurting projectiles or anything
shootable) nearer than rd_fx_nearcull (20 map units) are not drawn and fade in
up to rd_fx_nearfade (48).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt                                |  2 +-
 src/CMakeLists.txt                            |  3 ++-
 src/common/audio/sound/s_sound.cpp            | 25 ++++++++++++++++---
 src/common/engine/nx_perf.cpp                 |  9 +++++++
 src/common/engine/nx_perf.h                   |  2 ++
 src/rendering/hwrenderer/scene/hw_sprites.cpp | 24 ++++++++++++++++++
 6 files changed, 60 insertions(+), 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0c87a3b56..8d002b14a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -72,7 +72,7 @@ if( NINTENDO_SWITCH )
 	# our gcc complains about the use of alloca, stricmp, etc without including the appropriate headers
 	# unless we just do this
 	set( CMAKE_CXX_EXTENSIONS ON )
-	set( RDOOM_VERSION "1.1.2" )
+	set( RDOOM_VERSION "1.1.3" )
 	set( SWITCH_APP_VERSION "${RDOOM_VERSION}" )
 	# RDoom launcher sources (outside this tree so the engine stays a patch series)
 	set( RDOOM_LAUNCHER_DIR "${CMAKE_SOURCE_DIR}/../launcher" CACHE PATH "RDoom launcher source directory" )
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 57e600a5a..1c8efffab 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -1355,7 +1355,8 @@ if( NINTENDO_SWITCH )
 	if( HAVE_VULKAN )
 		set( PROJECT_LIBRARIES ${PROJECT_LIBRARIES} vulkan )
 	endif()
-	set( PROJECT_LIBRARIES ${PROJECT_LIBRARIES} expat zstd z )
+	# libsndfile is built with Ogg/Vorbis, FLAC and Opus (docker/Dockerfile)
+	set( PROJECT_LIBRARIES ${PROJECT_LIBRARIES} vorbisenc vorbis FLAC opus ogg expat zstd z )
 	# static ZMusic pulls in libsndfile (+ codecs) and mpg123
 	set( ZMUSIC_LIBRARIES ${ZMUSIC_LIBRARIES} sndfile FLAC opus vorbisenc vorbis ogg mpg123 m )
 	link_directories( $ENV{DEVKITPRO}/portlibs/switch/lib )
diff --git a/src/common/audio/sound/s_sound.cpp b/src/common/audio/sound/s_sound.cpp
index 7aab25fdf..3c2285a63 100644
--- a/src/common/audio/sound/s_sound.cpp
+++ b/src/common/audio/sound/s_sound.cpp
@@ -268,8 +268,8 @@ void SoundEngine::NXRestartPending()
 		// a short sound that would start way too late is better skipped.
 		// Start from the beginning (a delayed start sounds better than cutting off the attack).
 		chan->StartTime = 0;
-		if (!loading && (loop || now - since < 400)) RestartChannel(chan);
-		if ((chan->ChanFlags & CHANF_EVICTED) && !loop) ReturnChannel(chan);
+		if (!loading && (loop || now - since < 400)) { RestartChannel(chan); nxperf.sndwhy[7]++; }
+		if ((chan->ChanFlags & CHANF_EVICTED) && !loop) { ReturnChannel(chan); nxperf.sndwhy[8]++; }
 	}
 	// channels that went away in the meantime
 	for (auto it = nxPendingSince.begin(); it != nxPendingSince.end();)
@@ -626,7 +626,10 @@ FSoundChan *SoundEngine::StartSound(int type, const void *source,
 	FRolloffInfo *rolloff;
 
 	if (!isValidSoundId(sound_id) || volume <= 0 || nosfx || !SoundEnabled() || blockNewSounds)
+	{
+		nxperf.sndwhy[0]++;
 		return NULL;
+	}
 
 	// prevent crashes.
 	if (type == SOURCE_Unattached && pt == nullptr) type = SOURCE_None;
@@ -637,6 +640,7 @@ FSoundChan *SoundEngine::StartSound(int type, const void *source,
 
 	if (!ValidatePosVel(type, source, pos, vel))
 	{
+		nxperf.sndwhy[2]++;
 		return nullptr;
 	}
 
@@ -645,7 +649,10 @@ FSoundChan *SoundEngine::StartSound(int type, const void *source,
 	// Scale volume according to SNDINFO data.
 	volume = min(volume * sfx->Volume, 1.f);
 	if (volume <= 0)
+	{
+		nxperf.sndwhy[1]++;
 		return NULL;
+	}
 
 	// When resolving a link we do not want to get the NearLimit of
 	// the referenced sound so some additional checks are required
@@ -724,17 +731,19 @@ FSoundChan *SoundEngine::StartSound(int type, const void *source,
 	// eventually play for real.
 	if ((chanflags & (CHANF_EVICTED | CHANF_LOOP)) == CHANF_EVICTED)
 	{
+		nxperf.sndwhy[3]++;
 		return NULL;
 	}
 
 	// Make sure the sound is loaded (in the background if possible).
 	bool nxpending = false;
 	sfx = LoadSoundAsync(sfx, &nxpending);
-	if (nxpending) chanflags |= CHANF_EVICTED | CHANF_NXPENDING;
+	if (nxpending) { chanflags |= CHANF_EVICTED | CHANF_NXPENDING; nxperf.sndwhy[6]++; }
 
 	// The empty sound never plays.
 	if (sfx->lumpnum == sfx_empty)
 	{
+		nxperf.sndwhy[4]++;
 		return NULL;
 	}
 
@@ -779,6 +788,7 @@ FSoundChan *SoundEngine::StartSound(int type, const void *source,
 	// Such a sound would play right after unpausing which wouldn't sound right.
 	if (!(chanflags & CHANF_LOOP) && !(chanflags & (CHANF_UI|CHANF_NOPAUSE|CHANF_FORCE)) && SoundPaused)
 	{
+		nxperf.sndwhy[5]++;
 		return NULL;
 	}
 
@@ -881,13 +891,17 @@ void SoundEngine::RestartChannel(FSoundChan *chan)
 
 	// If this is a singular sound, don't play it if it's already playing.
 	if (sfx->bSingular && CheckSingular(chan->SoundID))
+	{
+		nxperf.sndrestart[0]++;
 		return;
+	}
 
 	sfx = LoadSound(sfx);
 
 	// The empty sound never plays.
 	if (sfx->lumpnum == sfx_empty)
 	{
+		nxperf.sndrestart[1]++;
 		return;
 	}
 
@@ -907,6 +921,7 @@ void SoundEngine::RestartChannel(FSoundChan *chan)
 
 		if (!ValidatePosVel(chan, pos, vel))
 		{
+			nxperf.sndrestart[2]++;
 			return;
 		}
 
@@ -914,6 +929,7 @@ void SoundEngine::RestartChannel(FSoundChan *chan)
 		// that's what would happen.
 		if (chan->NearLimit > 0 && CheckSoundLimit(&S_sfx[chan->SoundID.index()], pos, chan->NearLimit, chan->LimitRange, 0, NULL, 0, chan->DistanceScale))
 		{
+			nxperf.sndrestart[3]++;
 			return;
 		}
 
@@ -930,7 +946,10 @@ void SoundEngine::RestartChannel(FSoundChan *chan)
 	if (ochan == NULL)
 	{
 		chan->ChanFlags = oldflags;
+		nxperf.sndrestart[4]++;
 	}
+	else
+		nxperf.sndrestart[5]++;
 }
 
 //==========================================================================
