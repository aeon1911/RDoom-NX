From 1c1599ca7cddb468a699180e537fe05c216960b9 Mon Sep 17 00:00:00 2001
From: RDoom <171243930+aeon1911@users.noreply.github.com>
Date: Wed, 14 Oct 2026 20:24:50 -0300
Subject: [PATCH 63/64] RDoom 1.1.1: MP3 decoder prints nothing on the Switch

Console session (Project Brutality + WadFusion, Legacy of Rust MAP08):
engine-stderr.log had ~1000 lines of mpg123 resync notes, from PB's MP3
sounds that start with junk, all written to the SD card while playing.
MPG123_QUIET on the decoder handle; decoding is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt                                     | 2 +-
 libraries/ZMusic/source/decoder/mpg123_decoder.cpp | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9d7773feb..f67ba4afe 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -72,7 +72,7 @@ if( NINTENDO_SWITCH )
 	# our gcc complains about the use of alloca, stricmp, etc without including the appropriate headers
 	# unless we just do this
 	set( CMAKE_CXX_EXTENSIONS ON )
-	set( RDOOM_VERSION "1.1.0" )
+	set( RDOOM_VERSION "1.1.1" )
 	set( SWITCH_APP_VERSION "${RDOOM_VERSION}" )
 	# RDoom launcher sources (outside this tree so the engine stays a patch series)
 	set( RDOOM_LAUNCHER_DIR "${CMAKE_SOURCE_DIR}/../launcher" CACHE PATH "RDoom launcher source directory" )
diff --git a/libraries/ZMusic/source/decoder/mpg123_decoder.cpp b/libraries/ZMusic/source/decoder/mpg123_decoder.cpp
index b357f8010..58ba325e7 100644
--- a/libraries/ZMusic/source/decoder/mpg123_decoder.cpp
+++ b/libraries/ZMusic/source/decoder/mpg123_decoder.cpp
@@ -125,6 +125,12 @@ bool MPG123Decoder::open(MusicIO::FileInterface *reader)
 
     {
         MPG123 = mpg123_new(NULL, NULL);
+#ifdef __SWITCH__
+        // No printouts: Project Brutality's MP3 sounds start with junk and every
+        // one wrote resync notes to stderr, which RDoom keeps on the SD card
+        // (~1000 lines in one console session)
+        if (MPG123) mpg123_param(MPG123, MPG123_ADD_FLAGS, MPG123_QUIET, 0.);
+#endif
         if(mpg123_replace_reader_handle(MPG123, file_read, file_lseek, NULL) == MPG123_OK &&
            mpg123_open_handle(MPG123, this) == MPG123_OK)
         {
