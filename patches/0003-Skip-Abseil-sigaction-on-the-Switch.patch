From 6fccf27801a991a065523474dde90497b00aa49b Mon Sep 17 00:00:00 2001
From: Aeon <171243930+aeon1911@users.noreply.github.com>
Date: Mon, 28 Sep 2026 12:07:42 -0300
Subject: [PATCH 03/52] Skip Abseil sigaction on the Switch.

libnx does not provide SA_ONSTACK or sa_sigaction, so the failure
handler uses the plain signal() path. The port's own crash.log
handler stays in place.
---
 libraries/abseil/absl/debugging/failure_signal_handler.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libraries/abseil/absl/debugging/failure_signal_handler.cc b/libraries/abseil/absl/debugging/failure_signal_handler.cc
index 16609f171..219133037 100644
--- a/libraries/abseil/absl/debugging/failure_signal_handler.cc
+++ b/libraries/abseil/absl/debugging/failure_signal_handler.cc
@@ -55,7 +55,7 @@
 #include "absl/debugging/internal/examine_stack.h"
 #include "absl/debugging/stacktrace.h"
 
-#if !defined(_WIN32) && !defined(__wasi__)
+#if !defined(_WIN32) && !defined(__wasi__) && !defined(__SWITCH__)
 #define ABSL_HAVE_SIGACTION
 // Apple WatchOS and TVOS don't allow sigaltstack
 // Apple macOS has sigaltstack, but using it makes backtrace() unusable.
-- 
