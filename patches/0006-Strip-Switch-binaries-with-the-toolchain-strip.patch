From 550e7e8514b9a3f1818a7a5920b34a124bb701a4 Mon Sep 17 00:00:00 2001
From: Aeon <171243930+aeon1911@users.noreply.github.com>
Date: Mon, 28 Sep 2026 12:18:24 -0300
Subject: [PATCH 06/53] Strip Switch binaries with the toolchain strip.

The post-build nro step called aarch64-none-elf-strip by name, and that directory is not on PATH inside the devkit image. Use CMAKE_STRIP, which the Switch toolchain already sets to the full path.
---
 src/CMakeLists.txt              | 2 +-
 tools/nxlauncher/CMakeLists.txt | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 6d7c3715a..678f39059 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -1507,7 +1507,7 @@ endif()
 if( NINTENDO_SWITCH )
 	add_custom_command( TARGET zdoom POST_BUILD
 		COMMAND nacptool --create "UZDoom" "fgsfds, UZDoom team" "${SWITCH_APP_VERSION}" ${CMAKE_BINARY_DIR}/gzdoom.nacp
-		COMMAND aarch64-none-elf-strip -o ${CMAKE_BINARY_DIR}/gzdoom_stripped.elf $<TARGET_FILE:zdoom>
+		COMMAND ${CMAKE_STRIP} -o ${CMAKE_BINARY_DIR}/gzdoom_stripped.elf $<TARGET_FILE:zdoom>
 		COMMAND elf2nro ${CMAKE_BINARY_DIR}/gzdoom_stripped.elf ${CMAKE_BINARY_DIR}/gzdoom.nro --icon=${CMAKE_SOURCE_DIR}/nx/gzdoom.jpg --nacp=${CMAKE_BINARY_DIR}/gzdoom.nacp )
 endif()
 
diff --git a/tools/nxlauncher/CMakeLists.txt b/tools/nxlauncher/CMakeLists.txt
index 59bbf905e..44c4ce015 100644
--- a/tools/nxlauncher/CMakeLists.txt
+++ b/tools/nxlauncher/CMakeLists.txt
@@ -14,6 +14,6 @@ if( NINTENDO_SWITCH )
 	target_link_libraries( gzdoom_launcher -Wl,--start-group SDL2 EGL glapi drm_nouveau z nx m stdc++ -Wl,--end-group )
 	add_custom_command( TARGET gzdoom_launcher POST_BUILD
 		COMMAND nacptool --create "${APP_NAME}" "${APP_AUTHOR}" "${APP_VERSION}" "gzdoom_launcher.nacp"
-		COMMAND aarch64-none-elf-strip -o gzdoom_launcher_stripped.elf $<TARGET_FILE:gzdoom_launcher>
+		COMMAND ${CMAKE_STRIP} -o gzdoom_launcher_stripped.elf $<TARGET_FILE:gzdoom_launcher>
 		COMMAND elf2nro gzdoom_launcher_stripped.elf "${CMAKE_BINARY_DIR}/gzdoom_launcher.nro" --icon="${APP_ICON}" --nacp=gzdoom_launcher.nacp --romfsdir="${APP_RESDIR}" )
 endif()
