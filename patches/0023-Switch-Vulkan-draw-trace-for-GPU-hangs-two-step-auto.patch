From 31d8bf5cdf7c0189af5276bde52b501af2fc7138 Mon Sep 17 00:00:00 2001
From: RDoom <171243930+aeon1911@users.noreply.github.com>
Date: Sun, 11 Oct 2026 18:36:26 -0300
Subject: [PATCH 23/50] Switch Vulkan: draw trace for GPU hangs, two-step
 automatic workaround ladder

The first hardware reports show 'fifo idle timeout' (the GPU hangs on the
first 3D frame) and the driver workarounds tried one by one did not help.
- rd_vk_drawlog: one unbuffered boot.log line per recorded draw (pipeline key,
  texture) and per submit; with vk_submit_size 1 and NVK_DEBUG=push_sync the
  last line after a hang names the draw that hung.
- Automatic ladder after a lost GPU: step 1 = all driver workarounds plus D32S8
  depth (rd_vk_depth32), step 2 = trace mode.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/platform/posix/nx/rdoom_nx.h       |  4 +--
 src/common/platform/posix/sdl/sdlglvideo.cpp  | 27 ++++++++++++++----
 .../vulkan/renderer/vk_renderstate.cpp        | 28 +++++++++++++++++++
 .../vulkan/system/vk_commandbuffer.cpp        | 14 ++++++++++
 4 files changed, 65 insertions(+), 8 deletions(-)

diff --git a/src/common/platform/posix/nx/rdoom_nx.h b/src/common/platform/posix/nx/rdoom_nx.h
index 96a557e9e..89d8b0ca2 100644
--- a/src/common/platform/posix/nx/rdoom_nx.h
+++ b/src/common/platform/posix/nx/rdoom_nx.h
@@ -26,8 +26,8 @@ int RDoom_ClearShaderCaches();
 void RDoom_VulkanDeviceLost(const char *what);
 
 // Automatic GPU workarounds: each session that follows a lost GPU moves one step
-// further (0 = none, up to RDOOM_GPU_STEPS); the step is kept while it works and
+// further (0 = none, 1 = all driver workarounds + D32S8 depth, 2 = draw trace); the step is kept while it works and
 // starts over with a new build. Applied by the video start-up (sdlglvideo.cpp).
-#define RDOOM_GPU_STEPS 4
+#define RDOOM_GPU_STEPS 2
 bool RDoom_PreviousSessionLostGpu();
 int RDoom_GpuWorkaroundStep();
diff --git a/src/common/platform/posix/sdl/sdlglvideo.cpp b/src/common/platform/posix/sdl/sdlglvideo.cpp
index b773e6cad..9f278cb91 100644
--- a/src/common/platform/posix/sdl/sdlglvideo.cpp
+++ b/src/common/platform/posix/sdl/sdlglvideo.cpp
@@ -474,13 +474,28 @@ DFrameBuffer *SDLVideo::CreateFrameBuffer ()
 		FString applied;
 		setenv("NVK_SWITCH_PERF_LOG", "1", 1);  // the driver then reports channel errors in detail
 		applied += "NVK_SWITCH_PERF_LOG=1";
-		if (step >= 1) { setenv("NVK_DEBUG", "no_compression", 1); applied += " NVK_DEBUG=no_compression"; }
-		if (step >= 2) { setenv("NVK_SWITCH_NO_UBO_CBUF", "1", 1); applied += " NVK_SWITCH_NO_UBO_CBUF=1"; }
-		if (step >= 3) { setenv("NVK_SWITCH_MAPPED_COMPLETION", "0", 1); applied += " NVK_SWITCH_MAPPED_COMPLETION=0"; }
-		if (step >= 4)
+		auto setcvar = [&](const char *name, const char *value) {
+			if (FBaseCVar *cv = FindCVar(name, nullptr)) { UCVarValue v; v.String = value; cv->SetGenericRep(v, CVAR_String); }
+			applied.AppendFormat(" %s=%s", name, value);
+		};
+		if (step == 1)
 		{
-			if (FBaseCVar *cv = FindCVar("rd_vk_depth32", nullptr)) { UCVarValue v; v.Bool = true; cv->SetGenericRep(v, CVAR_Bool); }
-			applied += " rd_vk_depth32=1";
+			// every driver-side workaround at once (one at a time did not help on
+			// hardware, 2026-10-11) plus a D32S8 depth buffer
+			setenv("NVK_DEBUG", "no_compression", 1);
+			setenv("NVK_SWITCH_NO_UBO_CBUF", "1", 1);
+			setenv("NVK_SWITCH_MAPPED_COMPLETION", "0", 1);
+			applied += " NVK_DEBUG=no_compression NVK_SWITCH_NO_UBO_CBUF=1 NVK_SWITCH_MAPPED_COMPLETION=0";
+			setcvar("rd_vk_depth32", "1");
+		}
+		else if (step >= 2)
+		{
+			// trace mode: every draw submitted and waited for, one log line per draw
+			setenv("NVK_DEBUG", "push_sync", 1);
+			applied += " NVK_DEBUG=push_sync (trace mode)";
+			setcvar("vk_submit_size", "1");
+			setcvar("rd_vk_drawlog", "2");
+			setcvar("rd_vk_frameoverlap", "0");
 		}
 		FString d;
 		d.Format("step %d of %d%s: %s", step, RDOOM_GPU_STEPS, RDoom_PreviousSessionLostGpu() ? " (previous session lost the GPU)" : " (kept: no GPU loss since)", applied.GetChars());
diff --git a/src/common/rendering/vulkan/renderer/vk_renderstate.cpp b/src/common/rendering/vulkan/renderer/vk_renderstate.cpp
index b56358c18..3c7af8e9d 100644
--- a/src/common/rendering/vulkan/renderer/vk_renderstate.cpp
+++ b/src/common/rendering/vulkan/renderer/vk_renderstate.cpp
@@ -55,12 +55,39 @@ void VkRenderState::ClearScreen()
 	mCommandBuffer->draw(4, 1, FFlatVertexBuffer::FULLSCREEN_INDEX, 0);
 }
 
+#ifdef __SWITCH__
+// GPU-hang diagnostics: with vk_submit_size 1 and NVK_DEBUG=push_sync every draw
+// is submitted and waited for on its own; each recorded draw leaves a line in
+// logs/boot.log first, so after a hang the last line names the draw that hung.
+CVAR(Int, rd_vk_drawlog, 0, 0)
+extern int nx_levelframes;
+void RDoom_Crumb(const char *what);
+
+static void LogDraw(const VkPipelineKey &key, FMaterial *mat, const char *kind, int index, int count)
+{
+	static int logged;
+	if (rd_vk_drawlog <= 0 || nx_levelframes < 1 || nx_levelframes > rd_vk_drawlog || logged >= 6000)
+		return;
+	logged++;
+	char buf[220];
+	snprintf(buf, sizeof(buf), "draw %d (level frame %d): %s first %d count %d | vfmt %d effect %d special %d alphatest %d drawtype %d layers %d depth %d/%d stencil %d | %s",
+		logged, nx_levelframes, kind, index, count, key.VertexFormat, key.EffectState, key.SpecialEffect, key.AlphaTest, key.DrawType,
+		key.NumTextureLayers, key.DepthTest, key.DepthWrite, key.StencilTest,
+		mat && mat->Source() ? mat->Source()->GetName().GetChars() : "(no texture)");
+	RDoom_Crumb(buf);
+}
+#define RD_LOGDRAW(kind, index, count) LogDraw(mPipelineKey, mMaterial.mMaterial, kind, index, count)
+#else
+#define RD_LOGDRAW(kind, index, count)
+#endif
+
 void VkRenderState::Draw(int dt, int index, int count, bool apply)
 {
 	if (apply || mNeedApply)
 		Apply(dt);
 
 	mCommandBuffer->draw(count, 1, index, 0);
+	RD_LOGDRAW("draw", index, count);
 }
 
 void VkRenderState::DrawIndexed(int dt, int index, int count, bool apply)
@@ -69,6 +96,7 @@ void VkRenderState::DrawIndexed(int dt, int index, int count, bool apply)
 		Apply(dt);
 
 	mCommandBuffer->drawIndexed(count, 1, index, 0, 0);
+	RD_LOGDRAW("indexed", index, count);
 }
 
 bool VkRenderState::SetDepthClamp(bool on)
diff --git a/src/common/rendering/vulkan/system/vk_commandbuffer.cpp b/src/common/rendering/vulkan/system/vk_commandbuffer.cpp
index 833ff2577..cb2b503be 100644
--- a/src/common/rendering/vulkan/system/vk_commandbuffer.cpp
+++ b/src/common/rendering/vulkan/system/vk_commandbuffer.cpp
@@ -170,6 +170,20 @@ void VkCommandBufferManager::FlushCommands(VulkanCommandBuffer** commands, size_
 	}
 #endif
 
+#if defined(__SWITCH__)
+	{
+		extern int nx_levelframes;
+		static int logged;
+		EXTERN_CVAR(Int, rd_vk_drawlog)
+		if (rd_vk_drawlog > 0 && nx_levelframes >= 1 && nx_levelframes <= rd_vk_drawlog && logged < 6000)
+		{
+			void RDoom_Crumb(const char *what);
+			char buf[96];
+			snprintf(buf, sizeof(buf), "submit %d: %d command buffer(s)%s", ++logged, (int)count, finish ? ", frame end (post-processing + present)" : "");
+			RDoom_Crumb(buf);
+		}
+	}
+#endif
 	{
 		NXPERF_SCOPE(vksubmit_ms, &nxperf.vksubmits);
 		submit.Execute(fb->device.get(), fb->device->GraphicsQueue, mSubmitFence[currentIndex].get());
-- 
