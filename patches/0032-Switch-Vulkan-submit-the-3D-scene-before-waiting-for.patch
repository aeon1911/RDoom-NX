From 5c9c4c95e861bf88d939bcbb93323794e2f65430 Mon Sep 17 00:00:00 2001
From: RDoom <171243930+aeon1911@users.noreply.github.com>
Date: Mon, 12 Oct 2026 17:15:18 -0300
Subject: [PATCH 32/55] Switch Vulkan: submit the 3D scene before waiting for
 the swapchain

Console timestamps: the GPU needs 8-13 ms per frame, yet frames took
24-31 ms. The whole frame went into one end-of-frame submit that waits for
a free swapchain image at the colour-output stage, so the scene itself
waited for the display, and the GPU sat idle while the CPU recorded.
Now the scene is submitted when it ends (rd_vk_earlysubmit) and in blocks
of 300 draws while it is recorded (vk_submit_size 300 on the Switch); only
post-processing, 2D and the present copy wait for the swapchain image.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../rendering/vulkan/renderer/vk_renderstate.cpp    |  6 ++++++
 .../rendering/vulkan/system/vk_renderdevice.cpp     | 13 +++++++++++++
 2 files changed, 19 insertions(+)

diff --git a/src/common/rendering/vulkan/renderer/vk_renderstate.cpp b/src/common/rendering/vulkan/renderer/vk_renderstate.cpp
index f4ccc7c19..7db6bea61 100644
--- a/src/common/rendering/vulkan/renderer/vk_renderstate.cpp
+++ b/src/common/rendering/vulkan/renderer/vk_renderstate.cpp
@@ -39,7 +39,13 @@
 #include "hwrenderer/data/hw_viewpointbuffer.h"
 #include "hwrenderer/data/shaderuniforms.h"
 
+#ifdef __SWITCH__
+// The GPU starts on the first draws of a frame while the CPU still records the
+// rest (the frame's buffers only grow during a frame, so earlier submits stay valid).
+CVAR(Int, vk_submit_size, 300, 0);
+#else
 CVAR(Int, vk_submit_size, 1000, 0);
+#endif
 EXTERN_CVAR(Bool, r_skipmats)
 
 VkRenderState::VkRenderState(VulkanRenderDevice* fb) : fb(fb), mStreamBufferWriter(fb), mMatrixBufferWriter(fb)
diff --git a/src/common/rendering/vulkan/system/vk_renderdevice.cpp b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
index 7289a832c..355dfe381 100644
--- a/src/common/rendering/vulkan/system/vk_renderdevice.cpp
+++ b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
@@ -275,9 +275,22 @@ void VulkanRenderDevice::RenderTextureView(FCanvasTexture* tex, std::function<vo
 	tex->SetUpdated(true);
 }
 
+#ifdef __SWITCH__
+CVAR(Bool, rd_vk_earlysubmit, true, 0)
+#endif
+
 void VulkanRenderDevice::PostProcessScene(bool swscene, int fixedcm, float flash, const std::function<void()> &afterBloomDrawEndScene2D)
 {
 	mCommands->MarkGpu(VkCommandBufferManager::GpuSceneEnd);
+#ifdef __SWITCH__
+	// Hand the finished 3D scene to the GPU now. Only the end-of-frame submit
+	// waits for a free swapchain image; with the whole frame in that submit the
+	// scene itself waited for the display (vsync) and the GPU sat idle while
+	// the CPU recorded the frame (console perf.log: GPU 9-13 ms per frame, yet
+	// 24-31 ms frames).
+	if (rd_vk_earlysubmit)
+		mCommands->FlushCommands(false);
+#endif
 	if (!swscene) mPostprocess->BlitSceneToPostprocess(); // Copy the resulting scene to the current post process texture
 	mPostprocess->PostProcessScene(fixedcm, flash, afterBloomDrawEndScene2D);
 }
