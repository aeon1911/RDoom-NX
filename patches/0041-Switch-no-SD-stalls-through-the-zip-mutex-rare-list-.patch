+	const double waitMs = nxperf.vkpending_ms;	// this frame's wait at BeginFrame
 	mDynFramesSinceRise++;
 	if (mDynCeilingFrames > 0 && --mDynCeilingFrames == 0)
 		mDynCeiling = 1.0f;
