+}
+
+void volkLoadDevice(VkDevice device)
+{
+	s_loadedDevice = device;
+}
+
+VkInstance volkGetLoadedInstance(void)
+{
+	return s_loadedInstance;
+}
+
+VkDevice volkGetLoadedDevice(void)
+{
+	return s_loadedDevice;
+}
