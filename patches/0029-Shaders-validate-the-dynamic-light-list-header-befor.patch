From cd3caa9253a042aac67d9dd4414319b81a93a1ad Mon Sep 17 00:00:00 2001
From: RDoom <171243930+aeon1911@users.noreply.github.com>
Date: Mon, 12 Oct 2026 15:55:45 -0300
Subject: [PATCH 29/60] Shaders: validate the dynamic light list header before
 the light loops

A header read back as garbage turned the light loops into practically
endless GPU work: on the Switch's Tegra X1 the channel then dies with a
fifo idle timeout (device lost) on the first lit surface, e.g. the first
muzzle flash. getLightRange() accepts only a plausible header (0, ordered
list ends, at most 256 lights) and otherwise skips the surface's dynamic
lights, so every loop stays bounded.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 wadsrc/static/shaders/glsl/main.fp            | 19 +++++++++++++++++++
 wadsrc/static/shaders/glsl/material_normal.fp |  4 ++--
 wadsrc/static/shaders/glsl/material_pbr.fp    |  2 +-
 .../static/shaders/glsl/material_specular.fp  |  4 ++--
 4 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/wadsrc/static/shaders/glsl/main.fp b/wadsrc/static/shaders/glsl/main.fp
index 021afbe9f..66fcefbec 100644
--- a/wadsrc/static/shaders/glsl/main.fp
+++ b/wadsrc/static/shaders/glsl/main.fp
@@ -57,6 +57,25 @@ vec4 ProcessLight(Material mat, vec4 color);
 vec3 ProcessMaterialLight(Material material, vec3 color);
 vec2 GetTexCoord();
 
+//===========================================================================
+//
+// Light list range of the current surface (uLightIndex >= 0).
+// The header holds where the modulated, subtractive and additive lists end,
+// in vec4s (4 per light). It is checked before any loop uses it: a header
+// read back as garbage would make the light loops practically endless and
+// stop the GPU (a fifo idle timeout on the Switch's Tegra X1). Anything
+// implausible, NaN included, means no dynamic lights on this surface.
+//
+//===========================================================================
+
+ivec4 getLightRange()
+{
+	vec4 header = lights[uLightIndex];
+	if (header.x == 0.0 && header.y >= 0.0 && header.y <= header.z && header.z <= header.w && header.w <= 1024.0)
+		return ivec4(header) + ivec4(uLightIndex + 1);
+	return ivec4(uLightIndex + 1);
+}
+
 // These get Or'ed into uTextureMode because it only uses its 3 lowermost bits.
 const int TEXF_Brightmap = 0x10000;
 const int TEXF_Detailmap = 0x20000;
diff --git a/wadsrc/static/shaders/glsl/material_normal.fp b/wadsrc/static/shaders/glsl/material_normal.fp
index 63b3de05d..f929b6d78 100644
--- a/wadsrc/static/shaders/glsl/material_normal.fp
+++ b/wadsrc/static/shaders/glsl/material_normal.fp
@@ -58,7 +58,7 @@ vec3 ProcessMaterialLight(Material material, vec3 color)
 
 	if (uLightIndex >= 0)
 	{
-		ivec4 lightRange = ivec4(lights[uLightIndex]) + ivec4(uLightIndex + 1);
+		ivec4 lightRange = getLightRange();
 		if (lightRange.z > lightRange.x)
 		{
 			// modulated lights
@@ -93,7 +93,7 @@ vec3 ProcessMaterialLight(Material material, vec3 color)
 
 	if (uLightIndex >= 0)
 	{
-		ivec4 lightRange = ivec4(lights[uLightIndex]) + ivec4(uLightIndex + 1);
+		ivec4 lightRange = getLightRange();
 		if (lightRange.w > lightRange.z)
 		{
 			vec4 addlight = vec4(0.0,0.0,0.0,0.0);
diff --git a/wadsrc/static/shaders/glsl/material_pbr.fp b/wadsrc/static/shaders/glsl/material_pbr.fp
index eb437f97e..cbc2d1b72 100644
--- a/wadsrc/static/shaders/glsl/material_pbr.fp
+++ b/wadsrc/static/shaders/glsl/material_pbr.fp
@@ -98,7 +98,7 @@ vec3 ProcessMaterialLight(Material material, vec3 ambientLight)
 
 	if (uLightIndex >= 0)
 	{
-		ivec4 lightRange = ivec4(lights[uLightIndex]) + ivec4(uLightIndex + 1);
+		ivec4 lightRange = getLightRange();
 		if (lightRange.z > lightRange.x)
 		{
 			//
diff --git a/wadsrc/static/shaders/glsl/material_specular.fp b/wadsrc/static/shaders/glsl/material_specular.fp
index 06de74a00..fe9beaa49 100644
--- a/wadsrc/static/shaders/glsl/material_specular.fp
+++ b/wadsrc/static/shaders/glsl/material_specular.fp
@@ -57,7 +57,7 @@ vec3 ProcessMaterialLight(Material material, vec3 color)
 
 	if (uLightIndex >= 0)
 	{
-		ivec4 lightRange = ivec4(lights[uLightIndex]) + ivec4(uLightIndex + 1);
+		ivec4 lightRange = getLightRange();
 		if (lightRange.z > lightRange.x)
 		{
 			// modulated lights
@@ -103,7 +103,7 @@ vec3 ProcessMaterialLight(Material material, vec3 color)
 
 	if (uLightIndex >= 0)
 	{
-		ivec4 lightRange = ivec4(lights[uLightIndex]) + ivec4(uLightIndex + 1);
+		ivec4 lightRange = getLightRange();
 		if (lightRange.w > lightRange.z)
 		{
 			vec4 addlight = vec4(0.0,0.0,0.0,0.0);
