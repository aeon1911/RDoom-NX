+int art_write_loadbg(const Image *art, const char *outpath);
diff --git a/tools/nxlauncher/src/data.c b/tools/nxlauncher/src/data.c
new file mode 100644
index 000000000..d732f6934
--- /dev/null
+++ b/tools/nxlauncher/src/data.c
@@ -0,0 +1,587 @@
+#include "data.h"
+#include "platform.h"
+
+#include <stdio.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <ctype.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+Profile profiles[MAX_PROFILES];
+int nprofiles;
+int cur_profile;
+
+FileEntry iwad_files[MAX_FILES];
+int n_iwad_files;
+FileEntry pwad_files[MAX_FILES];
+int n_pwad_files;
+
+static int play_counter;
+static int ini_version = 0;
+
+const char *const preset_names[PRESET_COUNT] = { "Qualidade", "Equilibrado", "Switch (leve)" };
+const char *const preset_desc[PRESET_COUNT] =
+{
+	"Tudo ligado, como no PC. Pode travar em cenas pesadas.",
+	"Luzes leves; no Brutality: metade do sangue/cápsulas e barris de fogo simples.",
+	"Sem luzes, efeitos mínimos, barris originais do Doom, monstros mais simples.",
+};
+const char *const monster_names[5] = { "Padrão", "Sem monstros", "Rápidos", "Renascem", "Rápidos e renascem" };
+
+static const struct { const char *file, *title; } known_iwads[] =
+{
+	{ "doom_fusion.ipk3", "DOOM Fusion (WadFusion)" },
+	{ "doom_complete.pk3", "Doom Complete (WadSmoosh)" },
+	{ "doom.wad", "The Ultimate Doom" },
+	{ "doom2.wad", "Doom II" },
+	{ "doom2f.wad", "Doom II (Francês)" },
+	{ "tnt.wad", "Final Doom: TNT Evilution" },
+	{ "plutonia.wad", "Final Doom: The Plutonia Experiment" },
+	{ "doom1.wad", "Doom (Shareware)" },
+	{ "freedoom1.wad", "Freedoom: Phase 1" },
+	{ "freedoom2.wad", "Freedoom: Phase 2" },
+	{ "freedm.wad", "FreeDM" },
+	{ "chex.wad", "Chex Quest" },
+	{ "chex3.wad", "Chex Quest 3" },
+	{ "heretic.wad", "Heretic" },
+	{ "heretic1.wad", "Heretic (Shareware)" },
+	{ "hexen.wad", "Hexen" },
+	{ "hexdd.wad", "Hexen: Deathkings" },
+	{ "strife1.wad", "Strife" },
+	{ "sve.wad", "Strife: Veteran Edition" },
+	{ "harm1.wad", "Harmony" },
+	{ "hacx.wad", "HacX" },
+	{ "rotwb.wad", "Rise of the Wool Ball" },
+	{ "square1.pk3", "The Adventures of Square" },
+	{ "blasphem.wad", "Blasphemer" },
+	{ NULL, NULL }
+};
+
+// engine files that live next to gzdoom.nro and must not show up as games
+static const char *const engine_files[] =
+{
+	"uzdoom.pk3", "gzdoom.pk3", "game_support.pk3", "brightmaps.pk3", "lights.pk3",
+	"game_widescreen_gfx.pk3", "zd_extra.pk3", NULL
+};
+
+static int has_ext(const char *name, const char *const *exts)
+{
+	const char *d = strrchr(name, '.');
+	if (!d) return 0;
+	for (int i = 0; exts[i]; i++) if (!strcasecmp(d, exts[i])) return 1;
+	return 0;
+}
+
+const char *data_iwad_title(const char *iwad)
+{
+	const char *base = strrchr(iwad, '/');
+	base = base ? base + 1 : iwad;
+	for (int i = 0; known_iwads[i].file; i++)
+		if (!strcasecmp(base, known_iwads[i].file)) return known_iwads[i].title;
+	return NULL;
+}
+
+double data_file_mb(const char *dir, const char *name)
+{
+	char path[600];
+	snprintf(path, sizeof(path), "%s/%s", dir, name);
+	struct stat st;
+	if (stat(path, &st) == 0) return st.st_size / 1048576.0;
+	return 0;
+}
+
+void data_iwad_path(const char *iwad, char *out, int outlen)
+{
+	snprintf(out, outlen, BASEDIR "/iwads/%s", iwad);
+	struct stat st;
+	if (stat(out, &st) == 0) return;
+	snprintf(out, outlen, BASEDIR "/%s", iwad);
+	if (stat(out, &st) == 0) return;
+	snprintf(out, outlen, BASEDIR "/pwads/%s", iwad);
+}
+
+static int cmp_files(const void *a, const void *b)
+{
+	return strcasecmp(((const FileEntry *)a)->name, ((const FileEntry *)b)->name);
+}
+
+static void list_dir(const char *dir, const char *const *exts, int only_known, FileEntry *list, int *count)
+{
+	DIR *d = opendir(dir);
+	if (!d) return;
+	struct dirent *e;
+	while ((e = readdir(d)) && *count < MAX_FILES)
+	{
+		if (e->d_name[0] == '.') continue;
+		if (!has_ext(e->d_name, exts)) continue;
+		char path[600];
+		snprintf(path, sizeof(path), "%s/%s", dir, e->d_name);
+		struct stat st;
+		if (stat(path, &st) != 0 || S_ISDIR(st.st_mode)) continue;
+		int skip = 0;
+		for (int i = 0; engine_files[i]; i++) if (!strcasecmp(e->d_name, engine_files[i])) skip = 1;
+		if (skip) continue;
+		if (only_known && !data_iwad_title(e->d_name) && !has_ext(e->d_name, (const char *const[]){ ".ipk3", ".iwad", ".ipk7", NULL })) continue;
+		// no duplicates
+		for (int i = 0; i < *count; i++) if (!strcasecmp(list[i].name, e->d_name)) skip = 1;
+		if (skip) continue;
+		strncpy(list[*count].name, e->d_name, MAX_PATH_LEN - 1);
+		list[*count].mb = st.st_size / 1048576.0;
+		(*count)++;
+	}
+	closedir(d);
+	qsort(list, *count, sizeof(FileEntry), cmp_files);
+}
+
+void data_scan_files(void)
+{
+	static const char *const iwad_exts[] = { ".wad", ".iwad", ".ipk3", ".ipk7", ".pk3", ".pk7", ".zip", NULL };
+	static const char *const pwad_exts[] = { ".wad", ".pk3", ".pk7", ".zip", ".pke", ".ipk3", ".deh", ".bex", ".7z", NULL };
+	n_iwad_files = 0;
+	list_dir(BASEDIR "/iwads", iwad_exts, 0, iwad_files, &n_iwad_files);
+	list_dir(BASEDIR, iwad_exts, 1, iwad_files, &n_iwad_files);
+	n_pwad_files = 0;
+	list_dir(BASEDIR "/pwads", pwad_exts, 0, pwad_files, &n_pwad_files);
+}
+
+static void profile_defaults(Profile *p)
+{
+	memset(p, 0, sizeof(*p));
+	p->preset = PRESET_BALANCED;
+	p->scale = 100;
+	p->fpslimit = 0;
+	p->glthread = 0;
+	p->simplefx = 1;
+}
+
+static Profile *find_profile(const char *name)
+{
+	for (int i = 0; i < nprofiles; i++)
+		if (!strcasecmp(profiles[i].name, name)) return &profiles[i];
+	return NULL;
+}
+
+static int iwad_present(const char *iwad)
+{
+	for (int i = 0; i < n_iwad_files; i++) if (!strcasecmp(iwad_files[i].name, iwad)) return 1;
+	return 0;
+}
+
+int data_find_mod(const Profile *p, const char *name)
+{
+	for (int i = 0; i < p->nmods; i++) if (!strcasecmp(p->mods[i], name)) return i;
+	return -1;
+}
+
+int data_is_pb(const Profile *p)
+{
+	for (int i = 0; i < p->nmods; i++)
+	{
+		char low[MAX_PATH_LEN];
+		int j;
+		for (j = 0; p->mods[i][j] && j < MAX_PATH_LEN - 1; j++) low[j] = (char)tolower((unsigned char)p->mods[i][j]);
+		low[j] = 0;
+		if (strstr(low, "brutal") || !strncmp(low, "pb_", 3) || !strncmp(low, "pb-", 3) || strstr(low, "project_b") || strstr(low, "projectb")) return 1;
+	}
+	return 0;
+}
+
+//==========================================================================
+// ini file
+//==========================================================================
+
+static char last_profile_name[96];
+
+static void trim(char *s)
+{
+	char *p = s;
+	while (*p && isspace((unsigned char)*p)) p++;
+	if (p != s) memmove(s, p, strlen(p) + 1);
+	size_t n = strlen(s);
+	while (n > 0 && isspace((unsigned char)s[n - 1])) s[--n] = 0;
+}
+
+static void load_ini(void)
+{
+	FILE *f = fopen(BASEDIR "/launcher.ini", "r");
+	if (!f) return;
+	char line[1024];
+	Profile *p = NULL;
+	int in_launcher = 0;
+	while (fgets(line, sizeof(line), f))
+	{
+		trim(line);
+		if (!line[0] || line[0] == ';' || line[0] == '#') continue;
+		if (line[0] == '[')
+		{
+			char *e = strrchr(line, ']');
+			if (e) *e = 0;
+			const char *name = line + 1;
+			in_launcher = !strcmp(name, "@Launcher");
+			p = NULL;
+			if (in_launcher) continue;
+			p = find_profile(name);
+			if (!p && nprofiles < MAX_PROFILES)
+			{
+				p = &profiles[nprofiles++];
+				profile_defaults(p);
+				strncpy(p->name, name, sizeof(p->name) - 1);
+				p->builtin = 0;
+			}
+			else if (p)
+			{
+				// the saved mod list replaces the defaults
+				p->nmods = 0;
+			}
+			continue;
+		}
+		char *eq = strchr(line, '=');
+		if (!eq) continue;
+		*eq = 0;
+		char *key = line, *val = eq + 1;
+		trim(key);
+		trim(val);
+		if (in_launcher)
+		{
+			if (!strcasecmp(key, "LastProfile")) strncpy(last_profile_name, val, sizeof(last_profile_name) - 1);
+			else if (!strcasecmp(key, "Version")) ini_version = atoi(val);
+			else if (!strcasecmp(key, "PlayCounter")) play_counter = atoi(val);
+			continue;
+		}
+		if (!p) continue;
+		if (!strcasecmp(key, "IWAD")) strncpy(p->iwad, val, MAX_PATH_LEN - 1);
+		else if (!strcasecmp(key, "File") || !strcasecmp(key, "DEHFile") || !strcasecmp(key, "Mod"))
+		{
+			if (val[0] && p->nmods < MAX_MODS && data_find_mod(p, val) < 0) strncpy(p->mods[p->nmods++], val, MAX_PATH_LEN - 1);
+		}
+		else if (!strcasecmp(key, "Preset")) p->preset = atoi(val);
+		else if (!strcasecmp(key, "Boost")) p->boost = 0;	// option removed (no clock changes)
+		else if (!strcasecmp(key, "NoLoadScreen")) p->noloadscreen = atoi(val);
+		else if (!strcasecmp(key, "RenderScale")) p->scale = atoi(val);
+		else if (!strcasecmp(key, "FPSLimit")) p->fpslimit = atoi(val);
+		else if (!strcasecmp(key, "GLThread")) p->glthread = atoi(val);
+		else if (!strcasecmp(key, "SimpleShotFX")) p->simplefx = atoi(val);
+		else if (!strcasecmp(key, "ShowFPS")) p->showfps = atoi(val);
+		else if (!strcasecmp(key, "Skill")) p->skill = atoi(val);
+		else if (!strcasecmp(key, "Monsters"))
+		{
+			// old launcher stored the command line flag combination
+			int v = atoi(val);
+			p->monsters = v == 1 ? 1 : v == 2 ? 2 : v == 4 ? 3 : v == 6 ? 4 : 0;
+		}
+		else if (!strcasecmp(key, "MonsterMode")) p->monsters = atoi(val);
+		else if (!strcasecmp(key, "StartMap")) strncpy(p->warp, val, sizeof(p->warp) - 1);
+		else if (!strcasecmp(key, "PlayerClass")) strncpy(p->pclass, val, sizeof(p->pclass) - 1);
+		else if (!strcasecmp(key, "LoadGame")) strncpy(p->loadgame, val, MAX_PATH_LEN - 1);
+		else if (!strcasecmp(key, "WriteLog")) p->writelog = atoi(val);
+		else if (!strcasecmp(key, "ExtraArgs")) strncpy(p->extra, val, sizeof(p->extra) - 1);
+		else if (!strcasecmp(key, "LastPlayed")) p->lastplayed = atoi(val);
+	}
+	fclose(f);
+}
+
+int data_save(void)
+{
+	mkdir(BASEDIR, 0755);
+	FILE *f = fopen(BASEDIR "/launcher.ini.tmp", "w");
+	if (!f) return -1;
+	fprintf(f, "; UZDoom Switch launcher profiles\n\n[@Launcher]\nVersion = 6\n");
+	if (cur_profile >= 0 && cur_profile < nprofiles) fprintf(f, "LastProfile = %s\n", profiles[cur_profile].name);
+	fprintf(f, "PlayCounter = %d\n\n", play_counter);
+	for (int i = 0; i < nprofiles; i++)
+	{
+		Profile *p = &profiles[i];
+		fprintf(f, "[%s]\n", p->name);
+		fprintf(f, "IWAD = %s\n", p->iwad);
+		for (int m = 0; m < p->nmods; m++) fprintf(f, "Mod = %s\n", p->mods[m]);
+		fprintf(f, "Preset = %d\n", p->preset);
+		fprintf(f, "Boost = %d\n", p->boost);
+		if (p->noloadscreen) fprintf(f, "NoLoadScreen = %d\n", p->noloadscreen);
+		fprintf(f, "RenderScale = %d\n", p->scale);
+		fprintf(f, "FPSLimit = %d\n", p->fpslimit);
+		fprintf(f, "GLThread = %d\n", p->glthread);
+		fprintf(f, "SimpleShotFX = %d\n", p->simplefx);
+		fprintf(f, "ShowFPS = %d\n", p->showfps);
+		fprintf(f, "Skill = %d\n", p->skill);
+		fprintf(f, "MonsterMode = %d\n", p->monsters);
+		if (p->warp[0]) fprintf(f, "StartMap = %s\n", p->warp);
+		if (p->pclass[0]) fprintf(f, "PlayerClass = %s\n", p->pclass);
+		if (p->loadgame[0]) fprintf(f, "LoadGame = %s\n", p->loadgame);
+		fprintf(f, "WriteLog = %d\n", p->writelog);
+		if (p->extra[0]) fprintf(f, "ExtraArgs = %s\n", p->extra);
+		if (p->lastplayed) fprintf(f, "LastPlayed = %d\n", p->lastplayed);
+		fprintf(f, "\n");
+	}
+	fclose(f);
+	remove(BASEDIR "/launcher.ini");
+	return rename(BASEDIR "/launcher.ini.tmp", BASEDIR "/launcher.ini");
+}
+
+int data_init(void)
+{
+	mkdir(BASEDIR, 0755);
+	mkdir(BASEDIR "/iwads", 0755);
+	mkdir(BASEDIR "/pwads", 0755);
+	mkdir(TMPDIR, 0755);
+	data_scan_files();
+
+	// one profile per game file that was found
+	nprofiles = 0;
+	for (int i = 0; known_iwads[i].file; i++)
+	{
+		if (!iwad_present(known_iwads[i].file)) continue;
+		Profile *p = &profiles[nprofiles++];
+		profile_defaults(p);
+		strncpy(p->name, known_iwads[i].title, sizeof(p->name) - 1);
+		strncpy(p->iwad, known_iwads[i].file, MAX_PATH_LEN - 1);
+		p->builtin = 1;
+	}
+	for (int i = 0; i < n_iwad_files && nprofiles < MAX_PROFILES; i++)
+	{
+		if (data_iwad_title(iwad_files[i].name)) continue;
+		Profile *p = &profiles[nprofiles++];
+		profile_defaults(p);
+		// file name without extension
+		strncpy(p->name, iwad_files[i].name, sizeof(p->name) - 1);
+		char *dot = strrchr(p->name, '.');
+		if (dot) *dot = 0;
+		strncpy(p->iwad, iwad_files[i].name, MAX_PATH_LEN - 1);
+		p->builtin = 1;
+	}
+
+	ini_version = 0;
+	load_ini();
+
+	// nx3.2: Project Brutality profiles move to the lightest preset once
+	// (the heavy fights were far too slow with the others)
+	if (ini_version < 3)
+	{
+		for (int i = 0; i < nprofiles; i++)
+			if (data_is_pb(&profiles[i])) profiles[i].preset = PRESET_SWITCH;
+	}
+	// nx3.3: Brutality profiles get a steady 30 FPS cap once
+	if (ini_version < 4)
+	{
+		for (int i = 0; i < nprofiles; i++)
+			if (data_is_pb(&profiles[i])) profiles[i].fpslimit = 30;
+	}
+	// nx3.5: GL driver thread on for everybody, Brutality locked at 30 (VSync every other refresh)
+	if (ini_version < 5)
+	{
+		for (int i = 0; i < nprofiles; i++)
+		{
+			profiles[i].glthread = 1;
+			if (data_is_pb(&profiles[i])) profiles[i].fpslimit = 30;
+		}
+	}
+	// nx3.7: plain shot effects for everybody (only used with Brutality)
+	if (ini_version < 6)
+	{
+		// the GL driver thread froze the game on the console (nx3.6): off until it's proven
+		for (int i = 0; i < nprofiles; i++) { profiles[i].simplefx = 1; profiles[i].glthread = 0; }
+	}
+
+	// drop entries without a game file (keep custom ones so that nothing gets lost)
+	for (int i = 0; i < nprofiles; i++)
+	{
+		profiles[i].present = iwad_present(profiles[i].iwad);
+		if (profiles[i].preset < 0 || profiles[i].preset >= PRESET_COUNT) profiles[i].preset = PRESET_BALANCED;
+		if (profiles[i].scale < 50 || profiles[i].scale > 100) profiles[i].scale = 100;
+		if (profiles[i].fpslimit != 30 && profiles[i].fpslimit != 35 && profiles[i].fpslimit != 40) profiles[i].fpslimit = 0;
+		profiles[i].glthread = profiles[i].glthread ? 1 : 0;
+		profiles[i].simplefx = profiles[i].simplefx ? 1 : 0;
+		if (profiles[i].monsters < 0 || profiles[i].monsters > 4) profiles[i].monsters = 0;
+		if (profiles[i].skill < 0 || profiles[i].skill > 5) profiles[i].skill = 0;
+	}
+
+	cur_profile = -1;
+	for (int i = 0; i < nprofiles; i++)
+		if (profiles[i].present && !strcasecmp(profiles[i].name, last_profile_name)) cur_profile = i;
+	if (cur_profile < 0)
+		for (int i = 0; i < nprofiles; i++) if (profiles[i].present) { cur_profile = i; break; }
+	return cur_profile >= 0 ? 0 : -1;
+}
+
+int data_add_profile(const char *name, const char *iwad, const Profile *copyfrom)
+{
+	if (nprofiles >= MAX_PROFILES || !name[0]) return -1;
+	char uname[96];
+	strncpy(uname, name, sizeof(uname) - 1);
+	uname[sizeof(uname) - 1] = 0;
+	// unique name
+	for (int n = 2; find_profile(uname) && n < 100; n++) snprintf(uname, sizeof(uname), "%.80s (%d)", name, n);
+	Profile *p = &profiles[nprofiles];
+	if (copyfrom) *p = *copyfrom;
+	else profile_defaults(p);
+	strncpy(p->name, uname, sizeof(p->name) - 1);
+	p->name[sizeof(p->name) - 1] = 0;
+	strncpy(p->iwad, iwad, MAX_PATH_LEN - 1);
+	p->builtin = 0;
+	p->present = iwad_present(iwad);
+	p->lastplayed = 0;
+	return nprofiles++;
+}
+
+void data_delete_profile(int index)
+{
+	if (index < 0 || index >= nprofiles) return;
+	memmove(&profiles[index], &profiles[index + 1], (nprofiles - index - 1) * sizeof(Profile));
+	nprofiles--;
+	if (cur_profile >= nprofiles) cur_profile = nprofiles - 1;
+}
+
+//==========================================================================
+// starting the engine
+//==========================================================================
+
+static char *argp;
+static int argleft;
+
+static void arg(const char *fmt, ...)
+{
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(argp, argleft, fmt, ap);
+	va_end(ap);
+	if (n > 0 && n < argleft) { argp += n; argleft -= n; }
+}
+
+static int is_deh(const char *n)
+{
+	const char *d = strrchr(n, '.');
+	return d && (!strcasecmp(d, ".deh") || !strcasecmp(d, ".bex"));
+}
+
+// snd_channels/snd_efx are applied by the engine before its sound system starts
+static const char *const engine_presets[PRESET_COUNT] =
+{
+	"+set r_dynlights 1 +set gles_max_lights_per_surface 16 +set r_maxparticles 4000 +set cl_maxdecals 1024 +set gl_light_particles 1 "
+	"+set r_actorspriteshadow 1 +set r_actorspriteshadowdist 1500 +set gl_texture_filter_anisotropic 8 +set gl_sort_textures 0 +set snd_channels 128 +set snd_efx 1 "
+	"+set nx_effect_cull 0 +set nx_effect_minalpha 0 +set nx_fx_thin none +set nx_fx_far 0 ",
+
+	"+set r_dynlights 1 +set gles_max_lights_per_surface 6 +set r_maxparticles 600 +set cl_maxdecals 200 +set gl_light_particles 0 "
+	"+set r_actorspriteshadow 1 +set r_actorspriteshadowdist 800 +set gl_texture_filter_anisotropic 4 +set gl_sort_textures 1 +set snd_channels 64 +set snd_efx 0 "
+	"+set nx_effect_cull 4000 +set nx_effect_minalpha 0.06 +set nx_fx_thin none +set nx_fx_far 0 ",
+
+	"+set r_dynlights 0 +set gles_max_lights_per_surface 2 +set r_maxparticles 150 +set cl_maxdecals 64 +set gl_light_particles 0 "
+	"+set r_actorspriteshadow 1 +set r_actorspriteshadowdist 600 +set gl_texture_filter_anisotropic 2 +set gl_sort_textures 1 +set snd_channels 40 +set snd_efx 0 "
+	"+set nx_effect_cull 2500 +set nx_effect_minalpha 0.12 +set nx_fx_thin none +set nx_fx_far 0 ",
+};
+
+// Project Brutality's own options (only passed when PB is in the mod list).
+// Most of PB's cost in fights is the number of effect actors (blood, gibs,
+// casings, smoke) that all move and get drawn every tic.
+static const char *const pb_presets[PRESET_COUNT] =
+{
+	"+set PB_tracerlight 1 +set pb_performance_fire 0 +set pb_simplemonsterbehavior 0 +set pb_disable_decorations 0 +set pb_decorative_flame_barrels 0 "
+	"+set nashgore_maxgore 1024 +set nashgore_maxcasings 50 +set nashgore_bloodmult 1.0 +set nashgore_gibamount 255 "
+	"+set nashgore_footprints 1 +set nashgore_bloodspurt 1 +set nashgore_corpseblood 1 +set nashgore_splat 1 "
+	"+set pb_hidebloodmist 0 +set pb_cheapcasings 1 +set pb_dasheffect 1 +set pb_lowflashesmode 0 +set pb_showblooddrops 1 +set pb_showglasscracks 1 "
+	"+set pb_gunsmoketype 0 ",
+
+	// weapon smoke off (PB's own "Gun Smoke Type: Off" plus the barrel heat,
+	// casing and enemy muzzle smoke that option doesn't cover); nothing else is thinned
+	"+set PB_tracerlight 0 +set pb_performance_fire 1 +set pb_simplemonsterbehavior 0 +set pb_disable_decorations 0 +set pb_decorative_flame_barrels 1 "
+	"+set nashgore_maxgore 128 +set nashgore_maxcasings 16 +set nashgore_bloodmult 0.6 +set nashgore_gibamount 128 "
+	"+set nashgore_footprints 0 +set nashgore_bloodspurt 1 +set nashgore_corpseblood 0 +set nashgore_splat 1 "
+	"+set pb_hidebloodmist 1 +set pb_cheapcasings 1 +set pb_dasheffect 1 +set pb_lowflashesmode 0 +set pb_showblooddrops 1 +set pb_showglasscracks 1 "
+	"+set pb_gunsmoketype 2 ",
+
+	"+set PB_tracerlight 0 +set pb_performance_fire 1 +set pb_simplemonsterbehavior 1 +set pb_disable_decorations 1 +set pb_decorative_flame_barrels 1 "
+	"+set nashgore_maxgore 40 +set nashgore_maxcasings 6 +set nashgore_bloodmult 0.3 +set nashgore_gibamount 48 "
+	"+set nashgore_footprints 0 +set nashgore_bloodspurt 0 +set nashgore_corpseblood 0 +set nashgore_splat 0 "
+	"+set pb_hidebloodmist 1 +set pb_cheapcasings 1 +set pb_dasheffect 0 +set pb_lowflashesmode 1 +set pb_showblooddrops 0 +set pb_showglasscracks 0 "
+	"+set pb_huddynamics 0 +set pb_execution_box 0 "
+	"+set pb_gunsmoketype 2 ",
+};
+
+void data_launch(int index)
+{
+	Profile *p = &profiles[index];
+	static char args[8192];
+	static char exe[640];
+	static char full[8192 + 700];
+
+	p->lastplayed = ++play_counter;
+	cur_profile = index;
+	data_save();
+
+	// the engine's loading screen shows the profile name
+	FILE *f = fopen(TMPDIR "/loadinfo.txt", "w");
+	if (f)
+	{
+		fprintf(f, "%s\n", p->name);
+		fclose(f);
+	}
+
+	argp = args;
+	argleft = sizeof(args);
+	args[0] = 0;
+	arg("-iwad \"%s\" ", p->iwad);
+
+	int nfiles = 0, ndeh = 0;
+	for (int i = 0; i < p->nmods; i++) is_deh(p->mods[i]) ? ndeh++ : nfiles++;
+	if (nfiles)
+	{
+		arg("-file");
+		for (int i = 0; i < p->nmods; i++) if (!is_deh(p->mods[i])) arg(" \"%s\"", p->mods[i]);
+		arg(" ");
+	}
+	if (ndeh)
+	{
+		arg("-deh");
+		for (int i = 0; i < p->nmods; i++) if (is_deh(p->mods[i])) arg(" \"%s\"", p->mods[i]);
+		arg(" ");
+	}
+	if (p->skill > 0) arg("-skill %d ", p->skill);
+	switch (p->monsters)
+	{
+	case 1: arg("-nomonsters "); break;
+	case 2: arg("-fast "); break;
+	case 3: arg("-respawn "); break;
+	case 4: arg("-fast -respawn "); break;
+	}
+	if (p->loadgame[0]) arg("-loadgame \"save/%s\" ", p->loadgame);
+	// no CPU/GPU clock changes of any kind: -nxboost is never passed
+	if (p->noloadscreen) arg("-nxnoload ");
+
+	arg("%s", engine_presets[p->preset]);
+	if (data_is_pb(p))
+	{
+		arg("%s", pb_presets[p->preset]);
+		// purely visual effect actors that are dropped (nx_fx_thin, class = share kept)
+		char fx[1024] = "";
+		if (p->preset != PRESET_QUALITY)
+			// weapon smoke: barrel heat, casing and enemy muzzle smoke (PB's "Gun Smoke Type: Off" misses those)
+			strcat(fx, "PB_GunFireSmoke=0,GunFireSmoke=0,NewCasingSmoke=0,");
+		if (p->simplefx)
+			// shot effects like in the original game: no detailed bullet impacts, debris, sparks,
+			// ricochets, ejected casings or extra muzzle flashes (bullets, damage and blood stay)
+			strcat(fx, "PB_BaseBulletImpact=0,PB_AnimatedSmokeThinker=0,SparkX=0,HitSpark=0,RicoChet=0,"
+				"PB_CasingBase=0,RifleCaseSpawn=0,Mp40CaseSpawn=0,SMGCasingSpawner=0,MastermindCaseSpawn=0,ShotgunWad=0,"
+				"OrangeLensFlareAlt=0,PB_MuzzleSpark=0,MarineMuzzle1=0,");
+		size_t n = strlen(fx);
+		if (n > 0) { fx[n - 1] = 0; arg("+set nx_fx_thin %s ", fx); }
+	}
+	arg("+set vid_scalefactor %d.%02d ", p->scale / 100, p->scale % 100);
+	// 30 = VSync on every other refresh of the 60 Hz screen: a real lock with
+	// even frame pacing. 35/40 are plain caps without VSync.
+	if (p->fpslimit == 30) arg("+set vid_vsync 1 +set nx_swapinterval 2 +set cl_capfps 0 +set vid_maxfps 0 ");
+	else if (p->fpslimit == 35) arg("+set vid_vsync 0 +set nx_swapinterval 1 +set cl_capfps 1 +set vid_maxfps 0 ");
+	else if (p->fpslimit > 0) arg("+set vid_vsync 0 +set nx_swapinterval 1 +set cl_capfps 0 +set vid_maxfps %d ", p->fpslimit);
+	else arg("+set vid_vsync 1 +set nx_swapinterval 1 +set cl_capfps 0 +set vid_maxfps 0 ");
+	arg("+set nx_glthread %d +set r_ticstability 0 ", p->glthread ? 1 : 0);
+	arg("+set vid_fps %d ", p->showfps ? 1 : 0);
+	if (p->warp[0]) arg("+map %s ", p->warp);
+	if (p->pclass[0]) arg("+playerclass \"%s\" ", p->pclass);
+	if (p->writelog) arg("+logfile gzdoom.log ");
+	if (p->extra[0]) arg("%s ", p->extra);
+
+	snprintf(exe, sizeof(exe), "%s/%s/gzdoom.nro", plat_cwd(), BASEDIR);
+	snprintf(full, sizeof(full), "%s %s", exe, args);
+	plat_set_next_load(exe, full);
+}
diff --git a/tools/nxlauncher/src/data.h b/tools/nxlauncher/src/data.h
new file mode 100644
index 000000000..741811875
--- /dev/null
+++ b/tools/nxlauncher/src/data.h
@@ -0,0 +1,75 @@
+#pragma once
+
+#define MAX_PROFILES 64
+#define MAX_MODS 48
+#define MAX_PATH_LEN 256
+#define MAX_FILES 512
+
+enum Presets
+{
+	PRESET_QUALITY,
+	PRESET_BALANCED,
+	PRESET_SWITCH,
+	PRESET_COUNT
+};
+
+typedef struct
+{
+	char name[96];
+	char iwad[MAX_PATH_LEN];
+	int builtin;	// automatically created for an IWAD that was found
+	int present;	// the IWAD exists
+	int nmods;
+	char mods[MAX_MODS][MAX_PATH_LEN];	// in load order (.deh/.bex go to -deh)
+	int preset;
+	int boost;
+	int noloadscreen;
+	int scale;	// render scale in percent
+	int fpslimit;	// 0 = VSync 60, 30 = VSync every other refresh (locked 30), 35/40 = frame rate cap
+	int glthread;	// GL driver on its own CPU core (Mesa glthread)
+	int simplefx;	// Brutality: plain (vanilla-like) shot effects
+	int showfps;
+	int skill;	// 0 = ask in game
+	int monsters;	// index into monster options
+	char warp[32];
+	char pclass[64];
+	char loadgame[MAX_PATH_LEN];
+	int writelog;
+	char extra[256];
+	int lastplayed;	// counter for "recently played" order
+} Profile;
+
+typedef struct
+{
+	char name[MAX_PATH_LEN];
+	double mb;
+} FileEntry;
+
+extern Profile profiles[MAX_PROFILES];
+extern int nprofiles;
+extern int cur_profile;
+
+extern FileEntry iwad_files[MAX_FILES];
+extern int n_iwad_files;
+extern FileEntry pwad_files[MAX_FILES];
+extern int n_pwad_files;
+
+extern const char *const preset_names[PRESET_COUNT];
+extern const char *const preset_desc[PRESET_COUNT];
+extern const char *const monster_names[5];
+
+int data_init(void);
+void data_scan_files(void);
+int data_save(void);
+const char *data_iwad_title(const char *iwad);
+// full path (relative to the launcher's directory) of a game file
+void data_iwad_path(const char *iwad, char *out, int outlen);
+double data_file_mb(const char *dir, const char *name);
+int data_find_mod(const Profile *p, const char *name);
+int data_is_pb(const Profile *p);
+
+int data_add_profile(const char *name, const char *iwad, const Profile *copyfrom);
+void data_delete_profile(int index);
+
+// builds the engine's command line and schedules it; does not return on the Switch
+void data_launch(int index);
diff --git a/tools/nxlauncher/src/gfx.c b/tools/nxlauncher/src/gfx.c
new file mode 100644
index 000000000..9121b82be
--- /dev/null
+++ b/tools/nxlauncher/src/gfx.c
@@ -0,0 +1,553 @@
+#include "gfx.h"
+#include "platform.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+#define STB_TRUETYPE_IMPLEMENTATION
+#define STBTT_STATIC
+#include "stb_truetype.h"
+
+static SDL_Window *win;
+static SDL_Renderer *ren;
+
+//==========================================================================
+// fonts
+//==========================================================================
+
+static const char *const font_files[FONT_COUNT] =
+{
+	"fonts/BebasNeue-Regular.ttf",
+	"fonts/Poppins-Medium.ttf",
+	"fonts/Poppins-Bold.ttf",
+	"fonts/Poppins-Regular.ttf",
+};
+
+static unsigned char *font_data[FONT_COUNT];
+static stbtt_fontinfo font_info[FONT_COUNT];
+
+#define FIRST_CP 32
+#define NUM_CP 224	// 32..255
+#define NUM_EXTRA 6
+static const int extra_cp[NUM_EXTRA] = { 0x2022, 0x2026, 0x2013, 0x2014, 0x201C, 0x201D };
+
+typedef struct
+{
+	int font, size;
+	int aw, ah;
+	SDL_Texture *tex;
+	stbtt_packedchar pc[NUM_CP];
+	stbtt_packedchar px[NUM_EXTRA];
+	float ascent, lineh;
+} Atlas;
+
+#define MAX_ATLAS 40
+static Atlas atlases[MAX_ATLAS];
+static int natlases;
+
+static Atlas *GetAtlas(int font, int size)
+{
+	for (int i = 0; i < natlases; i++)
+		if (atlases[i].font == font && atlases[i].size == size) return &atlases[i];
+	if (natlases >= MAX_ATLAS || !font_data[font]) return NULL;
+
+	Atlas *a = &atlases[natlases];
+	memset(a, 0, sizeof(*a));
+	a->font = font;
+	a->size = size;
+
+	// smallest atlas that fits (the Switch shares RAM with the GPU)
+	int ov = size <= 24 ? 2 : 1;
+	float cell = (float)(size * ov + 2);
+	float need = 240.f * cell * cell * 0.62f;
+	int aw = 256, ah = 256;
+	while ((float)aw * ah < need) { if (aw <= ah) aw *= 2; else ah *= 2; }
+	unsigned char *bmp = NULL;
+	for (int attempt = 0; attempt < 4; attempt++)
+	{
+		bmp = calloc(aw, ah);
+		stbtt_pack_context spc;
+		stbtt_PackBegin(&spc, bmp, aw, ah, 0, 1, NULL);
+		stbtt_PackSetOversampling(&spc, ov, ov);
+		stbtt_pack_range ranges[2];
+		memset(ranges, 0, sizeof(ranges));
+		ranges[0].font_size = (float)size;
+		ranges[0].first_unicode_codepoint_in_range = FIRST_CP;
+		ranges[0].num_chars = NUM_CP;
+		ranges[0].chardata_for_range = a->pc;
+		ranges[1].font_size = (float)size;
+		ranges[1].array_of_unicode_codepoints = (int *)extra_cp;
+		ranges[1].num_chars = NUM_EXTRA;
+		ranges[1].chardata_for_range = a->px;
+		int ok = stbtt_PackFontRanges(&spc, font_data[font], 0, ranges, 2);
+		stbtt_PackEnd(&spc);
+		if (ok) break;
+		free(bmp);
+		bmp = NULL;
+		if (aw <= ah) aw *= 2; else ah *= 2;
+	}
+	if (!bmp) return NULL;
+	a->aw = aw;
+	a->ah = ah;
+
+	uint32_t *rgba = malloc((size_t)aw * ah * 4);
+	for (int i = 0; i < aw * ah; i++)
+	{
+		unsigned char *p = (unsigned char *)&rgba[i];
+		p[0] = p[1] = p[2] = 255;
+		p[3] = bmp[i];
+	}
+	free(bmp);
+	a->tex = gfx_make_texture(rgba, aw, ah, 1);
+	free(rgba);
+	SDL_SetTextureBlendMode(a->tex, SDL_BLENDMODE_BLEND);
+
+	float scale = stbtt_ScaleForPixelHeight(&font_info[font], (float)size);
+	int asc, desc, gap;
+	stbtt_GetFontVMetrics(&font_info[font], &asc, &desc, &gap);
+	a->ascent = asc * scale;
+	a->lineh = (asc - desc + gap) * scale;
+	natlases++;
+	return a;
+}
+
+static int DecodeUTF8(const char **ps)
+{
+	const unsigned char *p = (const unsigned char *)*ps;
+	int c = *p++;
+	if (c >= 0xF0 && p[0] && p[1] && p[2]) { c = ((c & 7) << 18) | ((p[0] & 63) << 12) | ((p[1] & 63) << 6) | (p[2] & 63); p += 3; }
+	else if (c >= 0xE0 && p[0] && p[1]) { c = ((c & 15) << 12) | ((p[0] & 63) << 6) | (p[1] & 63); p += 2; }
+	else if (c >= 0xC0 && p[0]) { c = ((c & 31) << 6) | (p[0] & 63); p += 1; }
+	*ps = (const char *)p;
+	return c;
+}
+
+static stbtt_packedchar *FindChar(Atlas *a, int cp, int *index, int *isextra)
+{
+	if (cp >= FIRST_CP && cp < FIRST_CP + NUM_CP) { *index = cp - FIRST_CP; *isextra = 0; return a->pc; }
+	for (int i = 0; i < NUM_EXTRA; i++)
+		if (extra_cp[i] == cp) { *index = i; *isextra = 1; return a->px; }
+	*index = '?' - FIRST_CP;
+	*isextra = 0;
+	return a->pc;
+}
+
+static float DrawOrMeasure(int font, int size, float x, float y, uint32_t c, const char *s, int draw, float maxw)
+{
+	Atlas *a = GetAtlas(font, size);
+	if (!a || !s) return 0;
+	if (draw)
+	{
+		SDL_SetTextureColorMod(a->tex, c >> 24, (c >> 16) & 255, (c >> 8) & 255);
+		SDL_SetTextureAlphaMod(a->tex, c & 255);
+	}
+	float px = x, py = y + a->ascent;
+	float limit = maxw > 0 ? x + maxw : 1e9f;
+	while (*s)
+	{
+		if (*s == '\n') break;
+		int cp = DecodeUTF8(&s);
+		int idx, ex;
+		stbtt_packedchar *pc = FindChar(a, cp, &idx, &ex);
+		stbtt_aligned_quad q;
+		float nx = px;
+		stbtt_GetPackedQuad(pc, a->aw, a->ah, idx, &nx, &py, &q, 0);
+		if (nx > limit) break;
+		if (draw)
+		{
+			SDL_Rect src = { (int)(q.s0 * a->aw + 0.5f), (int)(q.t0 * a->ah + 0.5f), (int)((q.s1 - q.s0) * a->aw + 0.5f), (int)((q.t1 - q.t0) * a->ah + 0.5f) };
+			SDL_FRect dst = { q.x0, q.y0, q.x1 - q.x0, q.y1 - q.y0 };
+			if (src.w > 0 && src.h > 0) SDL_RenderCopyF(ren, a->tex, &src, &dst);
+		}
+		px = nx;
+	}
+	return px - x;
+}
+
+float gfx_text(int font, int size, float x, float y, uint32_t c, const char *s)
+{
+	return DrawOrMeasure(font, size, x, y, c, s, 1, 0);
+}
+
+float gfx_text_w(int font, int size, const char *s)
+{
+	return DrawOrMeasure(font, size, 0, 0, 0, s, 0, 0);
+}
+
+float gfx_text_r(int font, int size, float xr, float y, uint32_t c, const char *s)
+{
+	float w = gfx_text_w(font, size, s);
+	gfx_text(font, size, xr - w, y, c, s);
+	return w;
+}
+
+float gfx_text_c(int font, int size, float cx, float y, uint32_t c, const char *s)
+{
+	float w = gfx_text_w(font, size, s);
+	gfx_text(font, size, cx - w * 0.5f, y, c, s);
+	return w;
+}
+
+float gfx_text_fit(int font, int size, float x, float y, float maxw, uint32_t c, const char *s)
+{
+	float w = gfx_text_w(font, size, s);
+	if (w <= maxw) return gfx_text(font, size, x, y, c, s);
+	float ew = gfx_text_w(font, size, "\xE2\x80\xA6");
+	float used = DrawOrMeasure(font, size, x, y, c, s, 1, maxw - ew);
+	gfx_text(font, size, x + used, y, c, "\xE2\x80\xA6");
+	return used + ew;
+}
+
+float gfx_line_h(int font, int size)
+{
+	Atlas *a = GetAtlas(font, size);
+	return a ? a->lineh : size;
+}
+
+//==========================================================================
+// software rendered shapes, cached as textures
+//==========================================================================
+
+typedef struct
+{
+	int kind, w, h;
+	float r, t;
+	uint32_t c1, c2;
+	SDL_Texture *tex;
+	int age;
+} Shape;
+
+#define MAX_SHAPES 256
+static Shape shapes[MAX_SHAPES];
+static int nshapes;
+static int frameno;
+
+static float Coverage(float px, float py, float w, float h, float r)
+{
+	float qx = fabsf(px - w * 0.5f) - (w * 0.5f - r);
+	float qy = fabsf(py - h * 0.5f) - (h * 0.5f - r);
+	float ox = qx > 0 ? qx : 0, oy = qy > 0 ? qy : 0;
+	float in = qx > qy ? qx : qy;
+	float d = sqrtf(ox * ox + oy * oy) + (in < 0 ? in : 0) - r;
+	float cov = 0.5f - d;
+	return cov < 0 ? 0 : cov > 1 ? 1 : cov;
+}
+
+static uint32_t Lerp(uint32_t a, uint32_t b, float t)
+{
+	int r = (int)((a >> 24) + (((int)(b >> 24) - (int)(a >> 24)) * t));
+	int g = (int)(((a >> 16) & 255) + ((((int)(b >> 16) & 255) - (int)((a >> 16) & 255)) * t));
+	int bl = (int)(((a >> 8) & 255) + ((((int)(b >> 8) & 255) - (int)((a >> 8) & 255)) * t));
+	int al = (int)((a & 255) + ((((int)b & 255) - (int)(a & 255)) * t));
+	return RGBA(r, g, bl, al);
+}
+
+// kinds: 0 = fill (vertical gradient), 1 = fill (horizontal gradient), 2 = outline, 3 = glow
+static SDL_Texture *GetShape(int kind, int w, int h, float r, float t, uint32_t c1, uint32_t c2)
+{
+	for (int i = 0; i < nshapes; i++)
+	{
+		Shape *s = &shapes[i];
+		if (s->kind == kind && s->w == w && s->h == h && s->r == r && s->t == t && s->c1 == c1 && s->c2 == c2)
+		{
+			s->age = frameno;
+			return s->tex;
+		}
+	}
+	if (w <= 0 || h <= 0 || w > 2048 || h > 2048) return NULL;
+	if (nshapes >= MAX_SHAPES)
+	{
+		// evict the oldest
+		int old = 0;
+		for (int i = 1; i < nshapes; i++) if (shapes[i].age < shapes[old].age) old = i;
+		SDL_DestroyTexture(shapes[old].tex);
+		shapes[old] = shapes[--nshapes];
+	}
+	uint32_t *px = calloc(w * h, 4);
+	for (int y = 0; y < h; y++)
+	{
+		for (int x = 0; x < w; x++)
+		{
+			float fx = x + 0.5f, fy = y + 0.5f;
+			float a = 0;
+			uint32_t col = c1;
+			if (kind == 0 || kind == 1)
+			{
+				a = Coverage(fx, fy, (float)w, (float)h, r);
+				if (c2 != c1) col = Lerp(c1, c2, kind == 0 ? fy / h : fx / w);
+			}
+			else if (kind == 2)
+			{
+				float outer = Coverage(fx, fy, (float)w, (float)h, r);
+				float ri = r - t > 0 ? r - t : 0;
+				float inner = Coverage(fx - t, fy - t, w - 2 * t, h - 2 * t, ri);
+				if (fx < t || fy < t || fx > w - t || fy > h - t) inner = 0;
+				a = outer - inner;
+				if (a < 0) a = 0;
+			}
+			else if (kind == 3)
+			{
+				float dx = (fx - w * 0.5f) / (w * 0.5f), dy = (fy - h * 0.5f) / (h * 0.5f);
+				float d2 = dx * dx + dy * dy;
+				a = d2 < 1 ? (1 - d2) * (1 - d2) : 0;
+			}
+			unsigned char *p = (unsigned char *)&px[y * w + x];
+			p[0] = col >> 24;
+			p[1] = (col >> 16) & 255;
+			p[2] = (col >> 8) & 255;
+			p[3] = (unsigned char)((col & 255) * a);
+		}
+	}
+	SDL_Texture *tex = gfx_make_texture(px, w, h, 1);
+	free(px);
+	Shape *s = &shapes[nshapes++];
+	s->kind = kind; s->w = w; s->h = h; s->r = r; s->t = t; s->c1 = c1; s->c2 = c2; s->tex = tex; s->age = frameno;
+	return tex;
+}
+
+static void DrawShape(SDL_Texture *t, float x, float y, float w, float h)
+{
+	if (!t) return;
+	SDL_FRect dst = { x, y, w, h };
+	SDL_RenderCopyF(ren, t, NULL, &dst);
+}
+
+void gfx_rect(float x, float y, float w, float h, uint32_t c)
+{
+	SDL_SetRenderDrawBlendMode(ren, SDL_BLENDMODE_BLEND);
+	SDL_SetRenderDrawColor(ren, c >> 24, (c >> 16) & 255, (c >> 8) & 255, c & 255);
+	SDL_FRect r = { x, y, w, h };
+	SDL_RenderFillRectF(ren, &r);
+}
+
+void gfx_rrect(float x, float y, float w, float h, float r, uint32_t c)
+{
+	gfx_rrect_grad(x, y, w, h, r, c, c, 1);
+}
+
+void gfx_rrect_grad(float x, float y, float w, float h, float r, uint32_t c1, uint32_t c2, int vert)
+{
+	int iw = (int)ceilf(w), ih = (int)ceilf(h);
+	DrawShape(GetShape(vert ? 0 : 1, iw, ih, r, 0, c1, c2), x, y, (float)iw, (float)ih);
+}
+
+void gfx_bar(float x, float y, float w, float h, uint32_t c1, uint32_t c2)
+{
+	// fixed-size texture stretched horizontally, for animated widths
+	int ih = (int)ceilf(h);
+	SDL_Texture *t = GetShape(1, 256, ih, h * 0.5f, 0, c1, c2);
+	if (!t) return;
+	SDL_FRect dst = { x, y, w, (float)ih };
+	SDL_RenderCopyF(ren, t, NULL, &dst);
+}
+
+void gfx_rrect_line(float x, float y, float w, float h, float r, float thick, uint32_t c)
+{
+	int iw = (int)ceilf(w), ih = (int)ceilf(h);
+	DrawShape(GetShape(2, iw, ih, r, thick, c, c), x, y, (float)iw, (float)ih);
+}
+
+void gfx_circle(float cx, float cy, float r, uint32_t c)
+{
+	int d = (int)ceilf(r * 2);
+	DrawShape(GetShape(0, d, d, d * 0.5f, 0, c, c), cx - d * 0.5f, cy - d * 0.5f, (float)d, (float)d);
+}
+
+void gfx_glow(float cx, float cy, float r, uint32_t c)
+{
+	SDL_Texture *t = GetShape(3, 128, 128, 0, 0, 0xFFFFFFFFu, 0xFFFFFFFFu);
+	if (!t) return;
+	SDL_SetTextureBlendMode(t, SDL_BLENDMODE_ADD);
+	SDL_SetTextureColorMod(t, c >> 24, (c >> 16) & 255, (c >> 8) & 255);
+	SDL_SetTextureAlphaMod(t, c & 255);
+	SDL_FRect dst = { cx - r, cy - r, r * 2, r * 2 };
+	SDL_RenderCopyF(ren, t, NULL, &dst);
+	SDL_SetTextureColorMod(t, 255, 255, 255);
+	SDL_SetTextureAlphaMod(t, 255);
+}
+
+void gfx_arrow(float cx, float cy, float size, int dir, uint32_t c)
+{
+	SDL_Vertex v[3];
+	SDL_Color col = { c >> 24, (c >> 16) & 255, (c >> 8) & 255, c & 255 };
+	float s = size * 0.5f;
+	SDL_FPoint p[3];
+	switch (dir)
+	{
+	case 0: p[0] = (SDL_FPoint){ cx, cy - s }; p[1] = (SDL_FPoint){ cx + s, cy + s * 0.6f }; p[2] = (SDL_FPoint){ cx - s, cy + s * 0.6f }; break;
+	case 1: p[0] = (SDL_FPoint){ cx, cy + s }; p[1] = (SDL_FPoint){ cx - s, cy - s * 0.6f }; p[2] = (SDL_FPoint){ cx + s, cy - s * 0.6f }; break;
+	case 2: p[0] = (SDL_FPoint){ cx - s, cy }; p[1] = (SDL_FPoint){ cx + s * 0.6f, cy - s }; p[2] = (SDL_FPoint){ cx + s * 0.6f, cy + s }; break;
+	default: p[0] = (SDL_FPoint){ cx + s, cy }; p[1] = (SDL_FPoint){ cx - s * 0.6f, cy + s }; p[2] = (SDL_FPoint){ cx - s * 0.6f, cy - s }; break;
+	}
+	for (int i = 0; i < 3; i++) { v[i].position = p[i]; v[i].color = col; v[i].tex_coord = (SDL_FPoint){ 0, 0 }; }
+	SDL_SetRenderDrawBlendMode(ren, SDL_BLENDMODE_BLEND);
+	SDL_RenderGeometry(ren, NULL, v, 3, NULL, 0);
+}
+
+//==========================================================================
+// button icons
+//==========================================================================
+
+float gfx_button(float x, float cy, int button, float size)
+{
+	const char *label = NULL;
+	int round = 1;
+	switch (button)
+	{
+	case BTN_A: label = "A"; break;
+	case BTN_B: label = "B"; break;
+	case BTN_X: label = "X"; break;
+	case BTN_Y: label = "Y"; break;
+	case BTN_L: label = "L"; round = 0; break;
+	case BTN_R: label = "R"; round = 0; break;
+	case BTN_ZL: label = "ZL"; round = 0; break;
+	case BTN_ZR: label = "ZR"; round = 0; break;
+	case BTN_PLUS: label = "+"; break;
+	case BTN_MINUS: label = "\xE2\x80\x93"; break;
+	default: break;
+	}
+	int fs = (int)(size * 0.62f);
+	if (button == BTN_UP || button == BTN_DOWN || button == BTN_LEFT || button == BTN_RIGHT || button == BTN_LSTICK)
+	{
+		// d-pad: a little cross, the direction highlighted
+		float s = size, t = s * 0.34f;
+		float x0 = x, y0 = cy - s * 0.5f;
+		gfx_rrect(x0 + (s - t) * 0.5f, y0, t, s, t * 0.3f, 0xE8E0DAFFu);
+		gfx_rrect(x0, y0 + (s - t) * 0.5f, s, t, t * 0.3f, 0xE8E0DAFFu);
+		uint32_t hi = C_ACCENT;
+		if (button == BTN_UP || button == BTN_LSTICK) gfx_rrect(x0 + (s - t) * 0.5f, y0, t, s * 0.36f, t * 0.3f, hi);
+		if (button == BTN_DOWN || button == BTN_LSTICK) gfx_rrect(x0 + (s - t) * 0.5f, y0 + s * 0.64f, t, s * 0.36f, t * 0.3f, hi);
+		if (button == BTN_LEFT) gfx_rrect(x0, y0 + (s - t) * 0.5f, s * 0.36f, t, t * 0.3f, hi);
+		if (button == BTN_RIGHT) gfx_rrect(x0 + s * 0.64f, y0 + (s - t) * 0.5f, s * 0.36f, t, t * 0.3f, hi);
+		return s;
+	}
+	if (!label) return 0;
+	float w = round ? size : fmaxf(size * 1.35f, gfx_text_w(FONT_BOLD, fs, label) + size * 0.7f);
+	gfx_rrect(x, cy - size * 0.5f, w, size, round ? size * 0.5f : size * 0.3f, 0xECE4DEFFu);
+	float lh = gfx_line_h(FONT_BOLD, fs);
+	gfx_text_c(FONT_BOLD, fs, x + w * 0.5f, cy - lh * 0.5f + fs * 0.06f, 0x1A1210FFu, label);
+	return w;
+}
+
+float gfx_hint(float x, float cy, int button, const char *label)
+{
+	float w = gfx_button(x, cy, button, 28);
+	float lh = gfx_line_h(FONT_BODY, 19);
+	float tw = gfx_text(FONT_BODY, 19, x + w + 8, cy - lh * 0.5f + 1, C_TEXT, label);
+	return w + 8 + tw + 26;
+}
+
+//==========================================================================
+// general
+//==========================================================================
+
+SDL_Texture *gfx_make_texture(const uint32_t *rgba, int w, int h, int linear)
+{
+	SDL_SetHint(SDL_HINT_RENDER_SCALE_QUALITY, linear ? "1" : "0");
+	SDL_Texture *t = SDL_CreateTexture(ren, SDL_PIXELFORMAT_RGBA32, SDL_TEXTUREACCESS_STATIC, w, h);
+	if (!t) return NULL;
+	SDL_UpdateTexture(t, NULL, rgba, w * 4);
+	SDL_SetTextureBlendMode(t, SDL_BLENDMODE_BLEND);
+	return t;
+}
+
+void gfx_draw_texture(SDL_Texture *t, float x, float y, float w, float h, uint8_t alpha)
+{
+	if (!t) return;
+	SDL_SetTextureAlphaMod(t, alpha);
+	SDL_FRect dst = { x, y, w, h };
+	SDL_RenderCopyF(ren, t, NULL, &dst);
+}
+
+int gfx_init(void)
+{
+	if (SDL_Init(SDL_INIT_VIDEO) < 0) return -1;
+	win = SDL_CreateWindow("UZDoom Launcher", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, SCR_W, SCR_H, 0);
+	if (!win) return -2;
+	ren = SDL_CreateRenderer(win, -1, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC);
+	if (!ren) ren = SDL_CreateRenderer(win, -1, 0);
+	if (!ren) return -3;
+	SDL_SetRenderDrawBlendMode(ren, SDL_BLENDMODE_BLEND);
+
+	for (int i = 0; i < FONT_COUNT; i++)
+	{
+		size_t sz = 0;
+		font_data[i] = plat_load_resource(font_files[i], &sz);
+		if (!font_data[i] || !stbtt_InitFont(&font_info[i], font_data[i], stbtt_GetFontOffsetForIndex(font_data[i], 0)))
+		{
+			free(font_data[i]);
+			font_data[i] = NULL;
+			if (i == FONT_BODY) return -4;
+		}
+	}
+	// fall back to the body font
+	for (int i = 0; i < FONT_COUNT; i++)
+	{
+		if (!font_data[i])
+		{
+			font_data[i] = font_data[FONT_BODY];
+			font_info[i] = font_info[FONT_BODY];
+		}
+	}
+	return 0;
+}
+
+void gfx_free(void)
+{
+	for (int i = 0; i < natlases; i++) SDL_DestroyTexture(atlases[i].tex);
+	natlases = 0;
+	for (int i = 0; i < nshapes; i++) SDL_DestroyTexture(shapes[i].tex);
+	nshapes = 0;
+	if (ren) SDL_DestroyRenderer(ren);
+	if (win) SDL_DestroyWindow(win);
+	ren = NULL;
+	win = NULL;
+	SDL_Quit();
+}
+
+SDL_Renderer *gfx_renderer(void)
+{
+	return ren;
+}
+
+void gfx_begin(void)
+{
+	frameno++;
+	SDL_SetRenderDrawColor(ren, 0, 0, 0, 255);
+	SDL_RenderClear(ren);
+}
+
+static void TakeScreenshot(void);
+
+void gfx_end(void)
+{
+	TakeScreenshot();
+	SDL_RenderPresent(ren);
+}
+
+#ifndef __SWITCH__
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#include "stb_image_write.h"
+#endif
+
+static char shotpath[256];
+
+// the picture is taken at the end of the next frame, before it is presented
+void gfx_screenshot(const char *path)
+{
+	strncpy(shotpath, path, sizeof(shotpath) - 1);
+}
+
+static void TakeScreenshot(void)
+{
+#ifndef __SWITCH__
+	if (!shotpath[0]) return;
+	uint32_t *px = malloc(SCR_W * SCR_H * 4);
+	if (SDL_RenderReadPixels(ren, NULL, SDL_PIXELFORMAT_RGBA32, px, SCR_W * 4) == 0)
+		stbi_write_png(shotpath, SCR_W, SCR_H, 4, px, SCR_W * 4);
+	free(px);
+#endif
+	shotpath[0] = 0;
+}
diff --git a/tools/nxlauncher/src/gfx.h b/tools/nxlauncher/src/gfx.h
new file mode 100644
index 000000000..134c6eae6
--- /dev/null
+++ b/tools/nxlauncher/src/gfx.h
@@ -0,0 +1,70 @@
+#pragma once
+
+#include <stdint.h>
+#include <SDL2/SDL.h>
+
+#define SCR_W 1280
+#define SCR_H 720
+
+// colors are 0xRRGGBBAA
+#define RGBA(r, g, b, a) ((uint32_t)(((r) & 255) << 24 | ((g) & 255) << 16 | ((b) & 255) << 8 | ((a) & 255)))
+#define WITH_ALPHA(c, a) (((c) & 0xFFFFFF00u) | ((uint32_t)(a) & 255))
+
+enum Fonts
+{
+	FONT_TITLE,	// Bebas Neue
+	FONT_BODY,	// Poppins Medium
+	FONT_BOLD,	// Poppins Bold
+	FONT_LIGHT,	// Poppins Regular
+	FONT_COUNT
+};
+
+// palette
+#define C_WHITE   0xFFFFFFFFu
+#define C_TEXT    0xF2ECE8FFu
+#define C_DIM     0xB3A7A0FFu
+#define C_MUTED   0x8A7F7AFFu
+#define C_ACCENT  0xFF4A1CFFu
+#define C_ACCENT2 0xFFB020FFu
+#define C_RED     0xC21E0EFFu
+#define C_GREEN   0x3DDC84FFu
+#define C_PANEL   0x0C0808B4u
+#define C_PANEL2  0x1A1210D8u
+
+int gfx_init(void);
+void gfx_free(void);
+SDL_Renderer *gfx_renderer(void);
+
+void gfx_begin(void);
+void gfx_end(void);
+void gfx_screenshot(const char *path);
+
+// shapes
+void gfx_rect(float x, float y, float w, float h, uint32_t c);
+void gfx_rrect(float x, float y, float w, float h, float r, uint32_t c);
+// vertical (vert=1) or horizontal gradient
+void gfx_rrect_grad(float x, float y, float w, float h, float r, uint32_t c1, uint32_t c2, int vert);
+void gfx_bar(float x, float y, float w, float h, uint32_t c1, uint32_t c2);
+void gfx_rrect_line(float x, float y, float w, float h, float r, float thick, uint32_t c);
+void gfx_circle(float cx, float cy, float r, uint32_t c);
+void gfx_glow(float cx, float cy, float r, uint32_t c);
+// small triangle pointing up/down/left/right (0..3)
+void gfx_arrow(float cx, float cy, float size, int dir, uint32_t c);
+
+// text; y is the top of the line
+float gfx_text(int font, int size, float x, float y, uint32_t c, const char *s);
+float gfx_text_w(int font, int size, const char *s);
+// right aligned / centered / truncated with an ellipsis
+float gfx_text_r(int font, int size, float xr, float y, uint32_t c, const char *s);
+float gfx_text_c(int font, int size, float cx, float y, uint32_t c, const char *s);
+float gfx_text_fit(int font, int size, float x, float y, float maxw, uint32_t c, const char *s);
+float gfx_line_h(int font, int size);
+
+// button icon (A/B/X/Y/L/R/ZL/ZR/+/-/dpad); returns the width used
+float gfx_button(float x, float cy, int button, float size);
+// icon + label, returns width used
+float gfx_hint(float x, float cy, int button, const char *label);
+
+// textures from RGBA memory
+SDL_Texture *gfx_make_texture(const uint32_t *rgba, int w, int h, int linear);
+void gfx_draw_texture(SDL_Texture *t, float x, float y, float w, float h, uint8_t alpha);
diff --git a/tools/nxlauncher/src/main.c b/tools/nxlauncher/src/main.c
new file mode 100644
index 000000000..1c3b3e987
--- /dev/null
+++ b/tools/nxlauncher/src/main.c
@@ -0,0 +1,33 @@
+// UZDoom Switch launcher
+
+#include "platform.h"
+#include "gfx.h"
+#include "data.h"
+#include "ui.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+int main(int argc, char **argv)
+{
+	(void)argc;
+	(void)argv;
+	if (plat_init()) return 1;
+	if (gfx_init())
+	{
+		FILE *f = fopen(BASEDIR "/launcher_error.log", "w");
+		if (f)
+		{
+			fprintf(f, "could not initialize graphics or load the fonts (romfs)\n");
+			fclose(f);
+		}
+		gfx_free();
+		return 1;
+	}
+	data_init();
+	ui_run();
+	ui_free();
+	gfx_free();
+	plat_free();
+	return 0;
+}
diff --git a/tools/nxlauncher/src/platform.c b/tools/nxlauncher/src/platform.c
new file mode 100644
index 000000000..fe70d4750
--- /dev/null
+++ b/tools/nxlauncher/src/platform.c
@@ -0,0 +1,263 @@
+#include "platform.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <SDL2/SDL.h>
+
+#ifdef __SWITCH__
+#include <switch.h>
+
+static PadState pad;
+static char cwd[512];
+
+void userAppInit(void)
+{
+	romfsInit();
+}
+
+void userAppExit(void)
+{
+	romfsExit();
+}
+
+int plat_init(void)
+{
+	padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+	padInitializeDefault(&pad);
+	padUpdate(&pad);
+	if (!getcwd(cwd, sizeof(cwd) - 1)) strcpy(cwd, "sdmc:/switch");
+	return 0;
+}
+
+void plat_free(void)
+{
+}
+
+int plat_loop(void)
+{
+	if (!appletMainLoop()) return 0;
+	padUpdate(&pad);
+	SDL_Event ev;
+	while (SDL_PollEvent(&ev))
+	{
+		if (ev.type == SDL_QUIT) return 0;
+	}
+	return 1;
+}
+
+uint32_t plat_buttons(void)
+{
+	u64 b = padGetButtons(&pad);
+	uint32_t r = 0;
+	if (b & HidNpadButton_A) r |= 1u << BTN_A;
+	if (b & HidNpadButton_B) r |= 1u << BTN_B;
+	if (b & HidNpadButton_X) r |= 1u << BTN_X;
+	if (b & HidNpadButton_Y) r |= 1u << BTN_Y;
+	if (b & HidNpadButton_L) r |= 1u << BTN_L;
+	if (b & HidNpadButton_R) r |= 1u << BTN_R;
+	if (b & HidNpadButton_ZL) r |= 1u << BTN_ZL;
+	if (b & HidNpadButton_ZR) r |= 1u << BTN_ZR;
+	if (b & HidNpadButton_Plus) r |= 1u << BTN_PLUS;
+	if (b & HidNpadButton_Minus) r |= 1u << BTN_MINUS;
+	if (b & (HidNpadButton_Up | HidNpadButton_StickLUp)) r |= 1u << BTN_UP;
+	if (b & (HidNpadButton_Down | HidNpadButton_StickLDown)) r |= 1u << BTN_DOWN;
+	if (b & (HidNpadButton_Left | HidNpadButton_StickLLeft)) r |= 1u << BTN_LEFT;
+	if (b & (HidNpadButton_Right | HidNpadButton_StickLRight)) r |= 1u << BTN_RIGHT;
+	if (b & HidNpadButton_StickL) r |= 1u << BTN_LSTICK;
+	if (b & HidNpadButton_StickR) r |= 1u << BTN_RSTICK;
+	return r;
+}
+
+int plat_keyboard(const char *header, const char *initial, char *out, int outlen)
+{
+	SwkbdConfig kbd;
+	if (R_FAILED(swkbdCreate(&kbd, 0))) return 0;
+	swkbdConfigMakePresetDefault(&kbd);
+	swkbdConfigSetHeaderText(&kbd, header);
+	swkbdConfigSetGuideText(&kbd, header);
+	if (initial) swkbdConfigSetInitialText(&kbd, initial);
+	char *tmp = calloc(1, outlen + 1);
+	Result rc = swkbdShow(&kbd, tmp, outlen);
+	swkbdClose(&kbd);
+	if (R_SUCCEEDED(rc))
+	{
+		strncpy(out, tmp, outlen - 1);
+		out[outlen - 1] = 0;
+	}
+	free(tmp);
+	return R_SUCCEEDED(rc);
+}
+
+int plat_applet_mode(void)
+{
+	AppletType t = appletGetAppletType();
+	return t != AppletType_Application && t != AppletType_SystemApplication;
+}
+
+void *plat_load_resource(const char *name, size_t *size)
+{
+	char path[256];
+	snprintf(path, sizeof(path), "romfs:/%s", name);
+	FILE *f = fopen(path, "rb");
+	if (!f) return NULL;
+	fseek(f, 0, SEEK_END);
+	long n = ftell(f);
+	fseek(f, 0, SEEK_SET);
+	void *buf = malloc(n + 1);
+	if (buf && fread(buf, 1, n, f) != (size_t)n) { free(buf); buf = NULL; }
+	fclose(f);
+	if (size) *size = n;
+	return buf;
+}
+
+void plat_set_next_load(const char *nro, const char *argv)
+{
+	envSetNextLoad(nro, argv);
+}
+
+uint64_t plat_ticks(void)
+{
+	return armTicksToNs(armGetSystemTick()) / 1000000ull;
+}
+
+const char *plat_cwd(void)
+{
+	return cwd;
+}
+
+#else // PC build for testing
+
+static uint32_t keys;
+static char cwd[512];
+
+int plat_init(void)
+{
+	if (!getcwd(cwd, sizeof(cwd) - 1)) strcpy(cwd, ".");
+	return 0;
+}
+
+void plat_free(void)
+{
+}
+
+static uint32_t keybit(SDL_Keycode k)
+{
+	switch (k)
+	{
+	case SDLK_RETURN: case SDLK_a: return 1u << BTN_A;
+	case SDLK_ESCAPE: case SDLK_BACKSPACE: case SDLK_b: return 1u << BTN_B;
+	case SDLK_x: return 1u << BTN_X;
+	case SDLK_y: return 1u << BTN_Y;
+	case SDLK_q: return 1u << BTN_L;
+	case SDLK_e: return 1u << BTN_R;
+	case SDLK_1: return 1u << BTN_ZL;
+	case SDLK_3: return 1u << BTN_ZR;
+	case SDLK_p: return 1u << BTN_PLUS;
+	case SDLK_m: return 1u << BTN_MINUS;
+	case SDLK_UP: return 1u << BTN_UP;
+	case SDLK_DOWN: return 1u << BTN_DOWN;
+	case SDLK_LEFT: return 1u << BTN_LEFT;
+	case SDLK_RIGHT: return 1u << BTN_RIGHT;
+	default: return 0;
+	}
+}
+
+// scripted input for automated screenshots: LAUNCHER_SCRIPT="down,down,a,shot:foo.png,..."
+extern void gfx_screenshot(const char *path);
+static char *script;
+static char *scriptpos;
+static uint64_t scriptnext;
+static uint32_t scriptkeys;
+
+static uint32_t name2btn(const char *n)
+{
+	static const char *names[BTN_COUNT] = { "a", "b", "x", "y", "l", "r", "zl", "zr", "plus", "minus", "up", "down", "left", "right", "ls", "rs" };
+	for (int i = 0; i < BTN_COUNT; i++) if (!strcmp(n, names[i])) return 1u << i;
+	return 0;
+}
+
+int plat_loop(void)
+{
+	SDL_Event ev;
+	while (SDL_PollEvent(&ev))
+	{
+		if (ev.type == SDL_QUIT) return 0;
+		if (ev.type == SDL_KEYDOWN) keys |= keybit(ev.key.keysym.sym);
+		if (ev.type == SDL_KEYUP) keys &= ~keybit(ev.key.keysym.sym);
+	}
+	if (!script)
+	{
+		const char *s = getenv("LAUNCHER_SCRIPT");
+		if (s) { script = strdup(s); scriptpos = script; scriptnext = plat_ticks() + 600; }
+	}
+	if (script && plat_ticks() >= scriptnext)
+	{
+		if (scriptkeys) { scriptkeys = 0; scriptnext = plat_ticks() + 120; return 1; }
+		if (!scriptpos || !*scriptpos) return 0; // script done -> quit
+		char tok[128];
+		size_t n = strcspn(scriptpos, ",");
+		if (n >= sizeof(tok)) n = sizeof(tok) - 1;
+		memcpy(tok, scriptpos, n); tok[n] = 0;
+		scriptpos += n; if (*scriptpos == ',') scriptpos++;
+		if (!strncmp(tok, "shot:", 5)) { gfx_screenshot(tok + 5); scriptnext = plat_ticks() + 50; }
+		else if (!strncmp(tok, "wait:", 5)) { scriptnext = plat_ticks() + atoi(tok + 5); }
+		else { scriptkeys = name2btn(tok); scriptnext = plat_ticks() + 120; }
+	}
+	return 1;
+}
+
+uint32_t plat_buttons(void)
+{
+	return keys | scriptkeys;
+}
+
+int plat_keyboard(const char *header, const char *initial, char *out, int outlen)
+{
+	const char *t = getenv("LAUNCHER_KBD");
+	if (!t) t = "Meu perfil";
+	strncpy(out, t, outlen - 1);
+	out[outlen - 1] = 0;
+	(void)header; (void)initial;
+	return 1;
+}
+
+int plat_applet_mode(void)
+{
+	return 0;
+}
+
+void *plat_load_resource(const char *name, size_t *size)
+{
+	char path[512];
+	const char *dir = getenv("LAUNCHER_RES");
+	snprintf(path, sizeof(path), "%s/%s", dir ? dir : "res", name);
+	FILE *f = fopen(path, "rb");
+	if (!f) return NULL;
+	fseek(f, 0, SEEK_END);
+	long n = ftell(f);
+	fseek(f, 0, SEEK_SET);
+	void *buf = malloc(n + 1);
+	if (buf && fread(buf, 1, n, f) != (size_t)n) { free(buf); buf = NULL; }
+	fclose(f);
+	if (size) *size = n;
+	return buf;
+}
+
+void plat_set_next_load(const char *nro, const char *argv)
+{
+	printf("NEXT LOAD: %s\nARGV: %s\n", nro, argv);
+}
+
+uint64_t plat_ticks(void)
+{
+	return SDL_GetTicks64();
+}
+
+const char *plat_cwd(void)
+{
+	return cwd;
+}
+
+#endif
