+	if (ConsoleState == c_up ||
 		ConsoleState == c_rising ||
 		menuactive != MENU_Off)
 	{
 		return false;
 	}
 
+	// allow joystick controls
+	if (C_HandleJoystick(ev, CmdLine))
+	{
+		return true;
+	}
+
+	if (ev->type != EV_GUI_Event)
+	{
+		return false;
+	}
+
 	return C_HandleKey(ev, CmdLine);
 }
 
