+#include "nx_loadscreen.h"
+
+class FSwitchStartupScreen : public FStartupScreen
+{
+public:
+	FSwitchStartupScreen(int max_progress) : FStartupScreen(max_progress) {}
+
+	void Progress(int advance = 1) override
+	{
+		CurPos = min(CurPos + advance, MaxPos);
+		NXLS_Progress(CurPos, MaxPos);
+	}
+};
+
+FStartupScreen *FStartupScreen::CreateInstance(int max_progress)
+{
+	return new FSwitchStartupScreen(max_progress);
+}
