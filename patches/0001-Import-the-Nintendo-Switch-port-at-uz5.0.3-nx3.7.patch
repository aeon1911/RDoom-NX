diff --git a/nx/uzdoom.ini b/nx/uzdoom.ini
new file mode 100644
index 000000000..08655f5d2
--- /dev/null
+++ b/nx/uzdoom.ini
@@ -0,0 +1,53 @@
+# Default UZDoom config for the Nintendo Switch build.
+# Copied next to the .nro; the engine rewrites it on exit with every setting.
+
+[IWADSearch.Directories]
+Path=.
+Path=$DOOMWADDIR
+Path=$PROGDIR/iwads
+Path=$PROGDIR/pwads
+Path=$PROGDIR
+
+[FileSearch.Directories]
+Path=$PROGDIR/pwads
+Path=$PROGDIR/iwads
+Path=$PROGDIR
+Path=$DOOMWADDIR
+
+[SoundfontSearch.Directories]
+Path=$PROGDIR/soundfonts
+Path=$PROGDIR/fm_banks
+
+[Doom.AutoExec]
+Path=./autoexec.cfg
+
+[Heretic.AutoExec]
+Path=./autoexec.cfg
+
+[Hexen.AutoExec]
+Path=./autoexec.cfg
+
+[Strife.AutoExec]
