From a50efb88837f050687906bafe554db6c7853ddda Mon Sep 17 00:00:00 2001
From: RDoom <171243930+aeon1911@users.noreply.github.com>
Date: Wed, 14 Oct 2026 10:33:09 -0300
Subject: [PATCH 54/60] Switch: dynamic resolution also follows sustained frame
 rate and GPU waits

Console test of c5638cdba: the pooled malloc took the game thread's heap
time from ~2.8 to 0.4-0.6 ms per frame and the Lexicon slaughter map ran
45-55 fps (1500-1780 actors), but Ashes 2063 and Compendium sat at 43-53
fps with the CPU waiting 13-15 ms per frame for the GPU while the GPU
timestamps read 12-13 ms: the timestamps do not see all of the GPU's load
and the view stayed at 78-100%. Averages over ~20 frames now also drop the
scale (frames above 18.7 ms with waits for the GPU above 6 ms), and the
scale only rises while the game holds 60 fps on average.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../rendering/vulkan/system/vk_renderdevice.cpp | 17 +++++++++++++++--
 .../rendering/vulkan/system/vk_renderdevice.h   |  3 ++-
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/src/common/rendering/vulkan/system/vk_renderdevice.cpp b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
index de97667e6..a6d493f83 100644
--- a/src/common/rendering/vulkan/system/vk_renderdevice.cpp
+++ b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
@@ -331,6 +331,8 @@ void VulkanRenderDevice::UpdateDynamicResolution()
 		mDynScale = 1.0f;
 		mDynCalmFrames = 0;
 		mDynGpuSamples = 0;	// a new map starts its own average (the Lexicon hub's must not carry over)
+		mDynAvgFrame = 1000.0 / 60.0;
+		mDynAvgWait = 0;
 		return;
 	}
 	// Drop: the previous frame missed vsync and this one had to wait for the
@@ -371,13 +373,22 @@ void VulkanRenderDevice::UpdateDynamicResolution()
 	// 20 ms frames), dropped every rise right back to 60% (2026-10-13 test).
 	// 8 samples at the new scale: with 30 the Lexicon hub (GPU 18-23 ms at
 	// full scale) spent its first seconds at 22 fps stepping down from 100%
+	// Sustained averages (~20 frames). Ashes 2063 on the console ran at 46-53
+	// fps with the CPU waiting 13-15 ms per frame for the GPU while the
+	// timestamps said 12-13 ms of GPU: they do not see all of its load, so a
+	// frame rate that stays below 60 with long waits for the GPU also drops
+	// the scale, and the scale only rises while the game holds 60 fps.
+	mDynAvgFrame += (frameMs - mDynAvgFrame) * 0.05;
+	mDynAvgWait += (waitMs - mDynAvgWait) * 0.05;
 	if (mDynGpuSeen && mDynGpuSamples < 8)
 		return;
 	if (mDynGpuSamples >= 8)
 	{
 		// the 3D view grows with its pixel count; the rest of the frame does not
 		auto predict = [&](float scale) { return mDynGpuFrame + mDynGpuScene * ((scale * scale) / (mDynScale * mDynScale) - 1.0); };
-		if (frameMs > budget + 1.5 && waitMs > 2.5 && mDynGpuFrame > budget * 0.9)
+		const bool gpuBound = (frameMs > budget + 1.5 && waitMs > 2.5 && mDynGpuFrame > budget * 0.9) ||
+			(mDynAvgFrame > budget * 1.12 && mDynAvgWait > 6.0);
+		if (gpuBound && mDynScale > minScale + 0.001f)
 		{
 			if (mDynFramesSinceRise < 120)
 			{
@@ -391,8 +402,10 @@ void VulkanRenderDevice::UpdateDynamicResolution()
 			mDynScale = clamp(floorf(s * 20.0f) / 20.0f, minScale, mDynScale - 0.05f);
 			mDynCalmFrames = 0;
 			mDynGpuSamples = 0;	// the average restarts at the new scale
+			mDynAvgFrame = budget;	// and so do the frame and wait averages
+			mDynAvgWait = 0;
 		}
-		else if (mDynScale < 1.0f && predict(min(1.0f, mDynScale + 0.05f)) < budget * 0.85)
+		else if (mDynScale < 1.0f && mDynAvgFrame < budget * 1.05 && predict(min(1.0f, mDynScale + 0.05f)) < budget * 0.85)
 		{
 			if (++mDynCalmFrames >= 45)
 			{
diff --git a/src/common/rendering/vulkan/system/vk_renderdevice.h b/src/common/rendering/vulkan/system/vk_renderdevice.h
index 18f9a2369..b19b0168d 100644
--- a/src/common/rendering/vulkan/system/vk_renderdevice.h
+++ b/src/common/rendering/vulkan/system/vk_renderdevice.h
@@ -145,7 +145,8 @@ private:
 	double mDynRestAtFull = 3.5;	// GPU ms outside the 3D view at full scale (running average)
 	double mDynGpuFrame = 0, mDynGpuScene = 0;	// GPU ms per frame / for the 3D view (running average)
 	int mDynGpuSamples = 0;
-	bool mDynGpuSeen = false;	// timestamps work here (not in Ryujinx)
+	bool mDynGpuSeen = false;
+	double mDynAvgFrame = 1000.0 / 60.0, mDynAvgWait = 0;	// frame time and wait for the GPU (running averages)	// timestamps work here (not in Ryujinx)
 	bool mSceneScaled = false;
 	IntRect mSceneFull, mSceneSmall;
 	void UpdateDynamicResolution();
