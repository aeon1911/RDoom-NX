From 3268c4f41bb67bdf10fd6eae832ed16642b01a7d Mon Sep 17 00:00:00 2001
From: Aeon <171243930+aeon1911@users.noreply.github.com>
Date: Mon, 28 Sep 2026 12:09:45 -0300
Subject: [PATCH 04/52] Build TiMidity++ strdup without POSIX strdup on the
 Switch.

The file is compiled as strict C++17, and newlib does not declare
strdup in that mode.
---
 libraries/ZMusic/thirdparty/timidityplus/common.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/libraries/ZMusic/thirdparty/timidityplus/common.cpp b/libraries/ZMusic/thirdparty/timidityplus/common.cpp
index 928be69d7..152fc5a57 100644
--- a/libraries/ZMusic/thirdparty/timidityplus/common.cpp
+++ b/libraries/ZMusic/thirdparty/timidityplus/common.cpp
@@ -64,11 +64,15 @@ void *safe_realloc(void *ptr, size_t count)
 char *safe_strdup(const char *s)
 {
 	if (s == nullptr) s = "";
-	auto p = strdup(s);
+	// newlib on the Switch does not declare strdup unless a POSIX feature
+	// macro is set, and this file is built as strict C++17.
+	size_t n = strlen(s) + 1;
+	auto p = static_cast<char *>(malloc(n));
 	if (p == nullptr)
 	{
 		abort();
 	}
+	memcpy(p, s, n);
 	return p;
 }
 
