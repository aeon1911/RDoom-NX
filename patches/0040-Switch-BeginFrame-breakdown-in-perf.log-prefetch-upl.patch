diff --git a/src/common/rendering/vulkan/system/vk_renderdevice.cpp b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
index 65346ebae..ad4d6dd2f 100644
--- a/src/common/rendering/vulkan/system/vk_renderdevice.cpp
+++ b/src/common/rendering/vulkan/system/vk_renderdevice.cpp
@@ -599,11 +599,17 @@ TArray<uint8_t> VulkanRenderDevice::GetScreenshotBuffer(int &pitch, ESSType &col
 
 void VulkanRenderDevice::BeginFrame()
 {
+	// perf.log "begin" breakdown: wait / cache save / buffers / sprites
+	double t = NXPerf_NowMS(), t2;
+	auto lap = [&](double &acc) { t2 = NXPerf_NowMS(); acc += t2 - t; t = t2; };
+
 	// the frame's region of the per-frame buffers is rewritten from the start
 	// below; only the frame that used the same region (two frames ago) must be done
 	mCommands->WaitForFrameSlot();
 	mFrameBegun = true;
+	lap(nxperf.begin_wait_ms);
 	mRenderPassManager->SaveCacheWhenIdle();
+	lap(nxperf.begin_save_ms);
 #ifdef __SWITCH__
 	UpdateDynamicResolution();
 #endif
@@ -615,7 +621,9 @@ void VulkanRenderDevice::BeginFrame()
 	mSaveBuffers->BeginFrame(SAVEPICWIDTH, SAVEPICHEIGHT, SAVEPICWIDTH, SAVEPICHEIGHT);
 	mRenderState->BeginFrame();
 	mDescriptorSetManager->BeginFrame();
+	lap(nxperf.begin_buffers_ms);
 	VkAsyncTex_NewFrame();
+	lap(nxperf.begin_sprites_ms);
 }
 
 void VulkanRenderDevice::InitLightmap(int LMTextureSize, int LMTextureCount, TArray<uint16_t>& LMTextureData)
diff --git a/src/common/rendering/vulkan/textures/vk_asynctex.cpp b/src/common/rendering/vulkan/textures/vk_asynctex.cpp
index c4fc19cde..0ae9792f5 100644
--- a/src/common/rendering/vulkan/textures/vk_asynctex.cpp
+++ b/src/common/rendering/vulkan/textures/vk_asynctex.cpp
@@ -342,6 +342,8 @@ namespace
 	{
 		const double start = NXPerf_NowMS();
 		const double budget = rd_vk_async_upload_ms;
+		// prefetches only after a frame that made it in time, with half the budget
+		const bool prefetches = NXPerf_LastFrameMS() < 1000.0 / 60.0 + 1.5;
 		int count = 0;
 		while (count < 24 && NXPerf_NowMS() - start < budget)
 		{
@@ -351,6 +353,8 @@ namespace
 			FTextureBuffer tb;
 			{
 				std::lock_guard<std::mutex> lock(jobMutex);
+				if (readyNow.empty() && (!prefetches || NXPerf_NowMS() - start >= budget * 0.5))
+					break;
 				auto &q = !readyNow.empty() ? readyNow : readyLater;
 				if (q.empty())
 					break;
diff --git a/src/common/rendering/vulkan/textures/vk_hwtexture.cpp b/src/common/rendering/vulkan/textures/vk_hwtexture.cpp
index 653ffb67e..25fd58563 100644
--- a/src/common/rendering/vulkan/textures/vk_hwtexture.cpp
+++ b/src/common/rendering/vulkan/textures/vk_hwtexture.cpp
@@ -166,6 +166,17 @@ void VkHardwareTexture::CreateTexture(int w, int h, int pixelsize, VkFormat form
 	int totalSize = w * h * pixelsize;
 	NXPERF_SCOPE(tex_ms, &nxperf.textures);	// perf.log "textures n/ms/kpix"
 	nxperf.texpixels += (int64_t)w * h;
+	struct SlowUpload
+	{
+		int w, h; double start = NXPerf_NowMS();
+		~SlowUpload()
+		{
+			const double ms = NXPerf_NowMS() - start;
+			nxperf.upload_max_ms = max(nxperf.upload_max_ms, ms);
+			if (ms >= 10.0)
+				NXPerf_Note("slow texture upload %.1f ms: %dx%d", ms, w, h);
+		}
+	} slowUpload{ w, h };
 
 	mImage.Image = ImageBuilder()
 		.Format(format)
