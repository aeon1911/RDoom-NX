+		mPostprocess->UpscaleScene(mSceneSmall, mSceneFull);
+		mSceneViewport = mSceneFull;
+	}
+#endif
 	mPostprocess->PostProcessScene(fixedcm, flash, afterBloomDrawEndScene2D);
 }
 
